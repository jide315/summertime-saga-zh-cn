# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:6
translate chinese okita_button_dress_code_4747e845:

    # anon "Hi {b}Miss Okita{/b}, I was hoping you could talk to {b}Mrs. Smith{/b} about the new dress code policy..."
    anon "嗨，{b}冲田老师{/b}，我希望你能跟{b}史密斯夫人{/b}谈谈新的着装规定……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:8
translate chinese okita_button_dress_code_f55e1db3:

    # okita "Hmmph!"
    okita "哼！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:10
translate chinese okita_button_dress_code_380f8086:

    # okita "I'm not going to subject myself to that foul woman just so you kids can wear baggy pants and short skirts!"
    okita "我才不会为了你们这些孩子能穿宽松裤子和短裙，就去求那个恶心的女人！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:11
translate chinese okita_button_dress_code_2e688915:

    # anon "No, that's not it... I'm concerned about the part restricting hair dye and I'd really like to-"
    anon "不，不是那样……我担心的是限制染发那部分，我真的很想——"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:13
translate chinese okita_button_dress_code_ba7c6fd8:

    # okita "Hair dye?"
    okita "染发？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:15
translate chinese okita_button_dress_code_22c7ecbe:

    # okita "That's what you're worried about?"
    okita "你担心的是这个？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:17
translate chinese okita_button_dress_code_09a61ea7:

    # anon "Y-yes, ma'am."
    anon "是、是的，老师。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:18
translate chinese okita_button_dress_code_de5455b5:

    # anon "My friend {b}Eve{/b} likes to dye her hair blue, and I was hoping you could convince {b}Mrs. Smith{/b} into changing the policy?"
    anon "我朋友{b}伊芙{/b}喜欢把头发染成蓝色，我希望你能说服{b}史密斯夫人{/b}改改这规定？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:20
translate chinese okita_button_dress_code_73118af4:

    # okita "Well, that's just silly!"
    okita "呃，这真是傻！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:21
translate chinese okita_button_dress_code_cd9ce46b:

    # okita "I've got a device upstairs that alters the pigmentation in hair follicles."
    okita "我楼上有个装置，能改变毛囊里的色素。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:23
translate chinese okita_button_dress_code_1c4bfff5:

    # anon f_worried @ f_surprised "You do?"
    anon f_worried @ f_surprised "你有？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:25
translate chinese okita_button_dress_code_8534e98f:

    # okita "Sure."
    okita "当然。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:26
translate chinese okita_button_dress_code_db37113f:

    # okita "I mean, it's still got a few kinks I need to work out..."
    okita "我是说，它还有几个小毛病要解决……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:27
translate chinese okita_button_dress_code_0b485507:

    # okita "... But if your friend is willing to be my lab rat for a few tests, I'm sure I can get it working in no time!"
    okita "……但如果你朋友愿意给我当几次实验小白鼠，我肯定很快就能弄好！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:29
translate chinese okita_button_dress_code_e594c648:

    # anon f_surprised "T-tests?"
    anon f_surprised "实、实验？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:31
translate chinese okita_button_dress_code_1ef8c0f3:

    # anon f_worried "I don't think that's a good idea, {b}Miss Okita{/b}..."
    anon f_worried "我不觉得这是个好主意，{b}冲田老师{/b}……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:33
translate chinese okita_button_dress_code_79bd5f84:

    # okita "Oh, come now!"
    okita "哦，来嘛！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:34
translate chinese okita_button_dress_code_5f98f07d:

    # okita "It's all noninvasive stuff... Well, mostly..."
    okita "都是无创的……嗯，大部分……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:35
translate chinese okita_button_dress_code_e4cbe7b1:

    # okita "There's a small chance she'll lose her hair completely but that's the absolute worst case scenario!"
    okita "有很小的几率她会完全掉光头发，但那是最糟的情况！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:37
translate chinese okita_button_dress_code_639a18fa:

    # anon a_facepalm @ -m_talk "..."
    anon a_facepalm @ -m_talk "……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:39
translate chinese okita_button_dress_code_8516f845:

    # okita "We're talking less than a one percent chance!"
    okita "我们说的是不到百分之一的几率！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:41
translate chinese okita_button_dress_code_25233d45:

    # anon a_idle f_worried @ f_unimpressed_bored "Ehh, I think I'll just check with the other teachers and see if one of them can help me..."
    anon a_idle f_worried @ f_unimpressed_bored "呃，我想我还是去问问其他老师，看他们谁能帮我……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:43
translate chinese okita_button_dress_code_b9e2d411:

    # okita "Alright, suit yourself."
    okita "好吧，随你。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:45
translate chinese okita_button_dress_code_77cd4d14:

    # anon "Thanks anyways, {b}Miss Okita{/b}."
    anon "还是谢谢你，{b}冲田老师{/b}。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:54
translate chinese button_okita_intro_ede83fd8:

    # anon "Alright, {b}Miss Okita{/b}. What do I have to do to get my grades up?"
    anon "好吧，{b}冲田老师{/b}。我要怎么做才能把成绩提上去？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:56
translate chinese button_okita_intro_47cced10:

    # okita "You're going to help me break free of my imposed banishment to the land of deficients."
    okita "你要帮我摆脱被强加的流放——流放到差生之地。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:58
translate chinese button_okita_intro_9631a652:

    # anon f_worried "Huh? Banishment? What in the world are you on about?"
    anon f_worried "啊？流放？你到底在说什么？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:60
translate chinese button_okita_intro_516c7413:

    # okita "Do you actually believe somebody of my intelligence belongs here, teaching basic science to a bunch of neanderthals?"
    okita "你真觉得我这种智商的人该待在这儿，给一群原始人教基础科学？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:62
translate chinese button_okita_intro_d39d9f55:

    # anon "Uhh..."
    anon "呃……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:64
translate chinese button_okita_intro_a07005ab:

    # okita "You think this is what I aspire to do with my life?!"
    okita "你觉得这就是我人生想做的事？！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:66
translate chinese button_okita_intro_6b8770a4:

    # anon @ f_skeptical "... No?"
    anon @ f_skeptical "……不是？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:68
translate chinese button_okita_intro_146b59c7:

    # okita "I used to be the bleeding edge, {b}[firstname]{/b}!"
    okita "我曾经是最前沿的人，{b}[firstname]{/b}！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:69
translate chinese button_okita_intro_3b80997d:

    # okita "I worked alongside some of the brightest minds on the planet, striving to forward humanity into the future!"
    okita "我跟这个星球上最聪明的一批头脑共事，努力推动人类走向未来！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:71
translate chinese button_okita_intro_7586c07a:

    # anon f_normal "That sounds... Intense! How did you end up here?"
    anon f_normal "听起来……挺猛的！你怎么沦落到这儿了？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:73
translate chinese button_okita_intro_950a5517:

    # okita "One day my colleagues forced me out!"
    okita "有一天，我的同事们把我挤走了！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:75
translate chinese button_okita_intro_fdc4851f:

    # anon f_surprised "What?! Why did they do that?"
    anon f_surprised "什么？！他们为什么那么做？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:77
translate chinese button_okita_intro_ab41af4f:

    # okita "Well, they claimed I was losing sight of the bigger picture."
    okita "呃，他们说我迷失了大局。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:78
translate chinese button_okita_intro_480d8c74:

    # okita "That I'd become so concerned with advancing the science that I'd lost sight of the ethics I'd sworn to uphold."
    okita "说我只顾推进科学，忘了自己发誓要坚守的伦理。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:80
translate chinese button_okita_intro_4809ac68:

    # anon f_worried @ -m_talk "..."
    anon f_worried @ -m_talk "……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:82
translate chinese button_okita_intro_aca8ff38:

    # okita "The truth of the matter, is that they were just intimidated by my intelligence."
    okita "而事实是，他们只是被我的智商吓到了。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:83
translate chinese button_okita_intro_5e395ea9:

    # okita "They couldn't keep up, so they banded together and got me blacklisted!"
    okita "他们跟不上，就联合起来把我列进黑名单！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:85
translate chinese button_okita_intro_94d033ff:

    # anon @ f_confused "Blacklisted? What does that mean?"
    anon @ f_confused "黑名单？那是什么意思？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:87
translate chinese button_okita_intro_a717d442:

    # okita "It means no worthwhile scientific institution will have me!"
    okita "意思就是没有哪家像样的科研机构会要我！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:89
translate chinese button_okita_intro_48afbce7:

    # okita "I've been ostracized to live out a dull existence in a monotonous place like this..."
    okita "我被排挤到这种单调乏味的地方，过着无聊的日子……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:90
translate chinese button_okita_intro_b0235345:

    # okita "... Surrounded by children and half-wits!"
    okita "……周围全是小孩和半吊子！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:92
translate chinese button_okita_intro_da6cdb6b:

    # anon "Well, that's a sad story and all but how am I supposed to help you?"
    anon "好吧，这故事挺惨，可我该怎么帮你？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:94
translate chinese button_okita_intro_37a905b6:

    # okita "Yes, well, it's simple really."
    okita "是啊，其实很简单。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:96
translate chinese button_okita_intro_598a9495:

    # okita "I just need to finish what I started."
    okita "我只需要把已经开始的事做完。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:98
translate chinese button_okita_intro_f79c204b:

    # anon "Huh?"
    anon "啊？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:100
translate chinese button_okita_intro_edd5022e:

    # okita "My inventions! The ones I was working on at Cuntech before those morons blacklisted me."
    okita "我的发明！我在婊科技做、后来被那帮白痴拉黑时正在搞的那些发明。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:101
translate chinese button_okita_intro_77f56183:

    # okita "If I could just prove they work and get one of them published."
    okita "只要我能证明它们有用，并把其中一个发表出来。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:103
translate chinese button_okita_intro_0e50eaa6:

    # anon "You think that would get you your job back?"
    anon "你觉得那样就能拿回工作？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:105
translate chinese button_okita_intro_7fbea37e:

    # okita "... I don't care about the job!"
    okita "……我不在乎工作！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:106
translate chinese button_okita_intro_1b497409:

    # okita "I want to show those backstabbers just how foolish they were, dismissing {b}Tori Okita{/b}!"
    okita "我要让那些背后捅刀的家伙看看，把{b}冲田托莉{/b}踢开有多蠢！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:108
translate chinese button_okita_intro_770e03ef:

    # okita "Besides, if even one of my inventions works, it'll be worth a fortune!"
    okita "再说，只要我有一项发明成功，就值一大笔钱！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:110
translate chinese button_okita_intro_d6e9efbb:

    # okita "I'll buy my own lab!"
    okita "我要买自己的实验室！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:112
translate chinese button_okita_intro_7f4dec79:

    # anon @ f_skeptical "... Still not seeing how I fit into all of this."
    anon @ f_skeptical "……我还是没看出来这跟我有什么关系。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:114
translate chinese button_okita_intro_f6e72380:

    # okita "Well, first off, I need you to {b}help me get into my office{/b}."
    okita "呃，首先，我需要你{b}帮我进我的办公室{/b}。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:116
translate chinese button_okita_intro_6aaa33c2:

    # anon f_normal @ f_laugh "You're locked out of your own office?"
    anon f_normal @ f_laugh "你被锁在自己办公室外面了？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:118
translate chinese button_okita_intro_9e6b976e:

    # okita "Yeah, that tyrant {b}Mrs. Smith{/b} locked me out!"
    okita "是啊，那个暴君{b}史密斯夫人{/b}把我锁外面了！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:120
translate chinese button_okita_intro_07e5fc09:

    # anon "The principal?!"
    anon "校长？！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:121
translate chinese button_okita_intro_d4dc0f75:

    # anon "Why would she do that?"
    anon "她为什么那么干？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:123
translate chinese button_okita_intro_fad22b67:

    # okita "She doesn't want me pursuing my pet projects during the school term."
    okita "她不想我在学期里搞私人项目。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:125
translate chinese button_okita_intro_ae13fda0:

    # okita "... Says I should remain one hundred percent focused on the curriculum."
    okita "……说我一门心思都该放在教学大纲上。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:127
translate chinese button_okita_intro_e3794861:

    # okita "It's utter nonsense!"
    okita "简直胡说八道！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:129
translate chinese button_okita_intro_a7cfc652:

    # anon f_worried @ f_confused "... How am I supposed to get you in?"
    anon f_worried @ f_confused "……我怎么帮你进去？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:131
translate chinese button_okita_intro_084482f1:

    # okita "With the {b}key code{/b} of course. {b}Mrs. Smith{/b} will have it {b}stashed away somewhere in her office{/b}, I'm sure."
    okita "当然是用{b}门禁密码{/b}。{b}史密斯夫人{/b}肯定把它{b}藏在办公室某个地方{/b}。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:133
translate chinese button_okita_intro_b483c690:

    # anon "You want me to {b}break into the principal's office and steal from her{/b}?!"
    anon "你想让我{b}闯进校长办公室偷东西{/b}？！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:135
translate chinese button_okita_intro_7895e978:

    # okita "It's not really stealing... I just need you to figure out the code."
    okita "不算偷……我只要你想办法弄到密码。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:137
translate chinese button_okita_intro_ac4a7208:

    # okita "Besides, you have nothing to lose... Remember?"
    okita "再说，你也没什么可失去的……记得吗？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:139
translate chinese button_okita_intro_866fd9dd:

    # anon @ a_point f_skeptical "She could expel me!"
    anon @ a_point f_skeptical "她会开除我！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:141
translate chinese button_okita_intro_6c799c6e:

    # okita "Would it really matter? You'll be stuck here for another year regardless if you flunk my class..."
    okita "那真的重要吗？不管怎样，你要是挂了我的课，就得在这儿多待一年……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:143
translate chinese button_okita_intro_4539629d:

    # anon "Yeah, but..."
    anon "是啊，可是……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:145
translate chinese button_okita_intro_b8dd8e27:

    # okita "Don't be foolish. This is a good deal! If you get the blueprints out of my office, help me build what's on them, and run a few tests to prove they work..."
    okita "别犯傻。这是个好交易！你要是把我办公室里的设计图拿出来，帮我照着造出来，再做几次测试证明它们有用……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:147
translate chinese button_okita_intro_6387c0a6:

    # okita "... I'll give you an A+ in my class."
    okita "……我就在我的课上给你一个 A+。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:149
translate chinese button_okita_intro_0cda91a4:

    # anon f_normal "An A+?!"
    anon f_normal "A+？！"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:150
translate chinese button_okita_intro_0a0aa64b:

    # anon a_thinking f_thinking "Hmm..."
    anon a_thinking f_thinking "嗯……"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:151
translate chinese button_okita_intro_10bfaba3:

    # anon "So, basically, either I help you do this or I'm stuck with a failing grade?"
    anon "所以，基本上，要么我帮你干这事，要么我就只能挂科？"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:153
translate chinese button_okita_intro_f12f34fb:

    # okita "Yeah. Without my help, I calculate your odds of passing my class to be about 3,720 to 1."
    okita "对。没有我的帮助，我算你通过我这门课的几率大约是三千七百二十比一。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:155
translate chinese button_okita_intro_265f7379:

    # anon a_idle f_worried @ f_skeptical "Sheesh, well, it's not like I have much choice then."
    anon a_idle f_worried @ f_skeptical "天哪，那我也没什么选择了。"

# lib/windows-i686/scripts/characters/okita/button_dialogues_1.rpyc:157
translate chinese button_okita_intro_6458a05a:

    # okita "You're finally starting to get a grasp on the situation!"
    okita "你终于开始抓住重点了！"


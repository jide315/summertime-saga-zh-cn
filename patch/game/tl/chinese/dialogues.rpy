# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:37
translate chinese church_angelicas_room_mia_return_priest_outfit_5b51ccbd:

    # angelica "Stealing the priest's robe... Impersonating our priest in the confessional..."
    angelica "偷走神父的长袍……在告解室里冒充我们的神父……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:38
translate chinese church_angelicas_room_mia_return_priest_outfit_7af7f551:

    # angelica "... And lying to that poor woman."
    angelica "……还对那个可怜的女人撒谎。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:41
translate chinese church_angelicas_room_mia_return_priest_outfit_41c2ab9d:

    # player_name "It's not what you think!"
    player_name "不是你想的那样！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:42
translate chinese church_angelicas_room_mia_return_priest_outfit_97719d69:

    # player_name "I was just trying to help her..."
    player_name "我只是想帮她……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:45
translate chinese church_angelicas_room_mia_return_priest_outfit_3048f2a4:

    # angelica "Help?"
    angelica "帮她？"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:46
translate chinese church_angelicas_room_mia_return_priest_outfit_e4bd878f:

    # angelica "The only person you can help now is yourself..."
    angelica "你现在唯一能帮的人就是你自己……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:47
translate chinese church_angelicas_room_mia_return_priest_outfit_cec2d131:

    # angelica "... Because I'm thinking about reporting you to the authorities."
    angelica "……因为我在考虑向当局举报你。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:50
translate chinese church_angelicas_room_mia_return_priest_outfit_3e098e59:

    # player_name "!!!"
    player_name "！！！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:52
translate chinese church_angelicas_room_mia_return_priest_outfit_b6573f18:

    # angelica "Unless... You do something for me."
    angelica "除非……你替我办件事。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:55
translate chinese church_angelicas_room_mia_return_priest_outfit_cc70aff3_1:

    # player_name "..."
    player_name "……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:57
translate chinese church_angelicas_room_mia_return_priest_outfit_0cbcf65b:

    # player_name "I don't see how I can be of any hel-"
    player_name "我看不出我能帮上什么——"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:60
translate chinese church_angelicas_room_mia_return_priest_outfit_31b709fb:

    # angelica "Come visit me in a week."
    angelica "一周后来见我。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:61
translate chinese church_angelicas_room_mia_return_priest_outfit_03ea6a6b:

    # angelica "I'll explain what I need from you..."
    angelica "我会说明我需要你做什么……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:62
translate chinese church_angelicas_room_mia_return_priest_outfit_96e48c9f:

    # angelica "... And don't try hiding from me, or everyone will know what you did..."
    angelica "……别想躲着我，不然所有人都会知道你干了什么……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:63
translate chinese church_angelicas_room_mia_return_priest_outfit_3bcda645:

    # angelica "... Especially that lady. The one I saw you with!"
    angelica "……尤其是那位女士。我看见你跟她在一起的那位！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:66
translate chinese church_angelicas_room_mia_return_priest_outfit_2aab34cb:

    # player_name "Please don't say anything to her... I'll be back. I promise."
    player_name "求你别跟她说……我会回来的，我保证。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:69
translate chinese church_angelicas_room_mia_return_priest_outfit_02ac650e:

    # angelica "Good."
    angelica "很好。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:70
translate chinese church_angelicas_room_mia_return_priest_outfit_1c9e413d:

    # angelica "Now, return what you stole and leave my chambers..."
    angelica "现在，把偷的东西还回来，然后离开我的房间……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:75
translate chinese church_angelicas_room_mia_return_priest_outfit_cc70aff3_2:

    # player_name "..."
    player_name "……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:86
translate chinese church_angelicas_room_mia_church_night_visit_5696d01b:

    # player_name "Hi, {b}Sister Angelica{/b}..."
    player_name "你好，{b}安吉莉卡修女{/b}……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:89
translate chinese church_angelicas_room_mia_church_night_visit_b659d90c:

    # angelica "I knew I could count on you."
    angelica "我就知道能指望你。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:90
translate chinese church_angelicas_room_mia_church_night_visit_991a8a1a:

    # angelica "You value our mutual agreement... And you value secrets."
    angelica "你看重我们之间的约定……也看重秘密。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:91
translate chinese church_angelicas_room_mia_church_night_visit_41827d26:

    # angelica "This is why I trust you will help me..."
    angelica "所以我相信你会帮我……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:94
translate chinese church_angelicas_room_mia_church_night_visit_a757def0:

    # player_name "So, what exactly are we talking about here?"
    player_name "那么，我们到底在谈什么？"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:97
translate chinese church_angelicas_room_mia_church_night_visit_cceaf1f7:

    # angelica "I perform a private sacrament at night... In my chambers..."
    angelica "我夜里会举行一种私人圣礼……在我的房间……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:99
translate chinese church_angelicas_room_mia_church_night_visit_96438cc8:

    # angelica "Its purpose is to help members of our church struggling with their impurities..."
    angelica "目的是帮助教会里那些与自身污秽挣扎的成员……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:100
translate chinese church_angelicas_room_mia_church_night_visit_7b931855:

    # angelica "... I help them purge away their sins!"
    angelica "……我帮他们洗净罪孽！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:103
translate chinese church_angelicas_room_mia_church_night_visit_00f962d9:

    # player_name "Sinners?"
    player_name "罪人？"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:106
translate chinese church_angelicas_room_mia_church_night_visit_814d488e:

    # angelica "That's right!"
    angelica "没错！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:107
translate chinese church_angelicas_room_mia_church_night_visit_627da8ac:

    # angelica "But, in order to keep performing this sacrament, I need to find appropriate candidates..."
    angelica "但是，为了继续举行这种圣礼，我需要找到合适的人选……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:108
translate chinese church_angelicas_room_mia_church_night_visit_3109a5a6:

    # angelica "... Freshly picked from our local worshipers!"
    angelica "……从我们本地的信徒中新鲜挑选的！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:111
translate chinese church_angelicas_room_mia_church_night_visit_b5e43d6c:

    # player_name "Okay, but what am I supposed to do?"
    player_name "好，可我要做什么？"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:114
translate chinese church_angelicas_room_mia_church_night_visit_e58be118:

    # angelica "I just need you to find some!"
    angelica "我只需要你去找几个！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:117
translate chinese church_angelicas_room_mia_church_night_visit_c22c869a:

    # player_name "You need me to find people?!"
    player_name "你要我去找人？！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:120
translate chinese church_angelicas_room_mia_church_night_visit_b43f2dec:

    # angelica "Yes, sinners."
    angelica "是的，罪人。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:123
translate chinese church_angelicas_room_mia_church_night_visit_cc70aff3:

    # player_name "..."
    player_name "……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:125
translate chinese church_angelicas_room_mia_church_night_visit_ccc6b5b1:

    # player_name "But, I don't really know anyone like that... I don't even-"
    player_name "可我不认识那样的人……我甚至——"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:128
translate chinese church_angelicas_room_mia_church_night_visit_e9fe77bd:

    # angelica "You DO know someone!"
    angelica "你确实认识一个！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:131
translate chinese church_angelicas_room_mia_church_night_visit_2929cdf9:

    # player_name "... But, who?!"
    player_name "……谁？！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:134
translate chinese church_angelicas_room_mia_church_night_visit_015ad8d8:

    # angelica "The lady from the confessional."
    angelica "告解室里的那位女士。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:135
translate chinese church_angelicas_room_mia_church_night_visit_c955c645:

    # angelica "Her name is {b}Helen{/b}."
    angelica "她叫{b}海伦{/b}。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:136
translate chinese church_angelicas_room_mia_church_night_visit_a713e145:

    # angelica "She has always been a devout servant of our Lord."
    angelica "她一直都是我们主虔诚的仆人。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:137
translate chinese church_angelicas_room_mia_church_night_visit_cfa7a6c7:

    # angelica "She believes herself to be very righteous and would never agree to my... Ritual."
    angelica "她自认非常正直，绝不会同意我的……仪式。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:138
translate chinese church_angelicas_room_mia_church_night_visit_e68a5c88:

    # angelica "But she had such a look of shame after talking with you in the confessional."
    angelica "但在告解室跟你谈过之后，她脸上满是羞愧。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:139
translate chinese church_angelicas_room_mia_church_night_visit_85cbfdc0:

    # angelica "You know her secret sins."
    angelica "你知道她隐秘的罪。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:140
translate chinese church_angelicas_room_mia_church_night_visit_b368a832:

    # angelica "And you will bring her to me."
    angelica "而你要把她带到我这儿来。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:141
translate chinese church_angelicas_room_mia_church_night_visit_2d60d485:

    # angelica "I personally enjoy purging the sins of the truly faithful."
    angelica "我本人很享受净化真正虔诚信徒的罪。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:142
translate chinese church_angelicas_room_mia_church_night_visit_65e4a322:

    # angelica "It is one of the most... Satisfying... Experiences of our religion."
    angelica "这是我们宗教中最……令人满足……的体验之一。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:145
translate chinese church_angelicas_room_mia_church_night_visit_3e098e59:

    # player_name "!!!"
    player_name "！！！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:147
translate chinese church_angelicas_room_mia_church_night_visit_fb6f6471:

    # player_name "You want me to {b}bring Helen here{/b}?!"
    player_name "你要我{b}把海伦带到这儿来{/b}？！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:150
translate chinese church_angelicas_room_mia_church_night_visit_ed680e36:

    # angelica "In my chambers, at night."
    angelica "夜里，在我的房间。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:153
translate chinese church_angelicas_room_mia_church_night_visit_72e44874:

    # player_name "How can I possibly convince her to come here?! I don't see how..."
    player_name "我怎么可能说服她来这儿？！我想不出办法……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:156
translate chinese church_angelicas_room_mia_church_night_visit_6d705ebe:

    # angelica "I'm sure you will find a way."
    angelica "我相信你会找到办法。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:157
translate chinese church_angelicas_room_mia_church_night_visit_1a7b1fce:

    # angelica "Both our interests are on the line here..."
    angelica "我们双方的利益都押在这上面……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:160
translate chinese church_angelicas_room_mia_church_night_visit_241b0c66:

    # player_name "{i}*Sigh*{/i}"
    player_name "{i}*叹气*{/i}"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:162
translate chinese church_angelicas_room_mia_church_night_visit_c9e2d812:

    # player_name "Okay, I'll give it a try... But what's this sacrament about anyway?"
    player_name "好吧，我试试……不过这圣礼到底是干什么的？"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:165
translate chinese church_angelicas_room_mia_church_night_visit_d6eb28f2:

    # angelica "You will find out, in due time."
    angelica "到时候你就知道了。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:168
translate chinese church_angelicas_room_mia_church_night_visit_0feb27e7:

    # player_name "I-I should really get going. It's getting late."
    player_name "我、我真该走了。天色不早了。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:171
translate chinese church_angelicas_room_mia_church_night_visit_b673275f:

    # angelica "Of course! Just make sure you remember our agreement."
    angelica "当然！只要记得我们的约定。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:174
translate chinese church_angelicas_room_mia_church_night_visit_cc70aff3_1:

    # player_name "..."
    player_name "……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:184
translate chinese church_angelicas_room_mia_church_sacrement_5457ffbe:

    # angelica "Thank you, {b}[firstname]{/b}, for bringing this wonderful disciple to us!"
    angelica "谢谢你，{b}[firstname]{/b}，把这么出色的信徒带到我们这儿来！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:185
translate chinese church_angelicas_room_mia_church_sacrement_2fc149d6:

    # angelica "{b}Helen{/b} has been attending our church for a very long time..."
    angelica "{b}海伦{/b}来我们教会已经很久了……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:186
translate chinese church_angelicas_room_mia_church_sacrement_34d447a1:

    # angelica "... And she told me everything about her failing marriage."
    angelica "……她把她那失败的婚姻全告诉我了。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:189
translate chinese church_angelicas_room_mia_church_sacrement_7587e921:

    # helen "I... I'm just hoping this will help me deal with our ungodly ways..."
    helen "我……我只希望这能帮我应对我们不敬神的那些事……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:192
translate chinese church_angelicas_room_mia_church_sacrement_e4030e33:

    # angelica "Indeed, {b}Helen{/b}."
    angelica "确实如此，{b}海伦{/b}。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:193
translate chinese church_angelicas_room_mia_church_sacrement_55f8e98b:

    # angelica "I'm proud of you for willing to face your demons."
    angelica "你愿意直面自己的心魔，我为你骄傲。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:194
translate chinese church_angelicas_room_mia_church_sacrement_a1451ef2:

    # angelica "Are you willing to follow my commands, in order to find the light?"
    angelica "你愿意听从我的指引，去寻得光明吗？"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:197
translate chinese church_angelicas_room_mia_church_sacrement_a2edba16:

    # helen "Yes. I am..."
    helen "是的，我愿意……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:200
translate chinese church_angelicas_room_mia_church_sacrement_8577d723:

    # angelica "Good! There will be three levels towards your redemption."
    angelica "很好！你的救赎要经过三个阶段。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:201
translate chinese church_angelicas_room_mia_church_sacrement_52cebfa9:

    # angelica "The first step requires that you rid yourself of all earthly materials..."
    angelica "第一步，你要褪去所有尘世之物……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:203
translate chinese church_angelicas_room_mia_church_sacrement_8cc58d9a:

    # angelica "... Such as your {i}clothes{/i}."
    angelica "……比如你的{i}衣服{/i}。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:204
translate chinese church_angelicas_room_mia_church_sacrement_85aa9484:

    # angelica "Only then, will we be able to start the process of purging your sins!"
    angelica "只有这样，我们才能开始净化你的罪！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:207
translate chinese church_angelicas_room_mia_church_sacrement_f65079c0:

    # helen "You don't actually expect me to... Get undressed here?!"
    helen "你不会真要我……在这儿脱衣服吧？！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:210
translate chinese church_angelicas_room_mia_church_sacrement_79c7b1da:

    # angelica "We are God's creatures, {b}Helen{/b}... We are all equal!"
    angelica "我们都是上帝的造物，{b}海伦{/b}……我们都是平等的！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:211
translate chinese church_angelicas_room_mia_church_sacrement_b2a3efc0:

    # angelica "You shouldn't be ashamed of who you are..."
    angelica "你不该为自己的样子感到羞耻……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:214
translate chinese church_angelicas_room_mia_church_sacrement_cf21649d:

    # helen "..."
    helen "……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:217
translate chinese church_angelicas_room_mia_church_sacrement_25d563ca:

    # angelica "Go on, {b}Helen{/b}. Rid yourself of it all..."
    angelica "来吧，{b}海伦{/b}。把一切褪去……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:222
translate chinese church_angelicas_room_mia_church_sacrement_4dd0b30d:

    # helen "If this is what I must do, then I shall do it..."
    helen "如果这是我必须做的，那我就做……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:231
translate chinese church_angelicas_room_mia_church_sacrement_3e098e59:

    # player_name "!!!"
    player_name "！！！"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:234
translate chinese church_angelicas_room_mia_church_sacrement_06ea8f17:

    # angelica "Well done, {b}Helen{/b}."
    angelica "做得很好，{b}海伦{/b}。"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:237
translate chinese church_angelicas_room_mia_church_sacrement_cf21649d_1:

    # helen "..."
    helen "……"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:240
translate chinese church_angelicas_room_mia_church_sacrement_fe20e716:

    # angelica "{b}[firstname]{/b}?"
    angelica "{b}[firstname]{/b}？"

# lib/windows-i686/scripts/locations/church/angelica_s_room/dialogues.rpyc:244
translate chinese church_angelicas_room_mia_church_sacrement_7ccfd79f:

    # player_name "Ehh... Yes?"

translate chinese confessional_right_mia_priest_act_pray_86fba08e:

    # player_name "Damn, I got too nervous..."
    player_name "该死，我太紧张了……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:71
translate chinese confessional_right_mia_priest_act_pray_62ebfae8:

    # player_name "... I need to try again later, with more confidence."
    player_name "……我得晚点再试一次，更有自信一点。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:81
translate chinese confessional_right_mia_priest_act_change_0dd5c326:

    # player_name "Perhaps it is {b}you{/b} who needs to change, in order for them to return to the path..."
    player_name "也许需要改变的是{b}你{/b}，他们才能回到正途……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:84
translate chinese confessional_right_mia_priest_act_change_29713288:

    # helen "Me?! ... But I've done everything right. I..."
    helen "我？！……可我每件事都做对了。我……"


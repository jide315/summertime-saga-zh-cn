    player_name "对！"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:42
translate chinese confessional_right_mia_priest_act_pray_c90e106a:

    # helen "I don't quite see how this will help my family, {b}Father{/b}."
    helen "我看不出这对我家有什么用，{b}神父{/b}。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:43
translate chinese confessional_right_mia_priest_act_pray_c35a5458:

    # helen "Something must be done! Something must change for them to recognize their sinful and vile behavior."
    helen "必须做点什么！必须有什么改变，他们才能认清自己罪恶可耻的行为。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:46
translate chinese confessional_right_mia_priest_act_pray_f7323737:

    # player_name "Err... The Lord works in mysterious ways!"
    player_name "呃……主的行事方式奥妙难测！"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:48
translate chinese confessional_right_mia_priest_act_pray_cf21649d_1:

    # helen "..."
    helen "……"


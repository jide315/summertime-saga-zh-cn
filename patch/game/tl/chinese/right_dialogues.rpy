translate chinese confessional_right_mia_priest_act_change_5ab554a3:

    # player_name "Err... Umm... Have a blessed day."
    player_name "呃……唔……祝你今天蒙福。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:131
translate chinese confessional_right_mia_priest_act_change_22a6fef1:

    # helen "What would you have me do as penance, {b}Father{/b}?"
    helen "你要我做什么苦修，{b}神父{/b}？"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:134

translate chinese confessional_right_mia_priest_act_change_6c27b031:

    # helen "It's just they don't seem to understand their peril... Like I do..."
    helen "只是他们好像不明白自己的危险……不像我……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:99
translate chinese confessional_right_mia_priest_act_change_2dffad5f:

    # helen "I do it, because I love them..."
    helen "我这么做，是因为我爱他们……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:102
translate chinese confessional_right_mia_priest_act_change_62ad3ee8:

    # player_name "You can still redeem yourself!"
    player_name "你还能救赎自己！"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:105
translate chinese confessional_right_mia_priest_act_change_a351dab3:

    # helen "Redeem? But what could I do?"
    helen "救赎？可我能做什么？"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:108
translate chinese confessional_right_mia_priest_act_change_c22d901d:

    # player_name "Maybe you could try to be more accepting of your husband..."
    player_name "也许你可以试着多接纳你丈夫一些……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:109
translate chinese confessional_right_mia_priest_act_change_2280b2c7:

    # player_name "... And give your daughter some freedom to grow!"
    player_name "……给你女儿一些成长的空间！"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:111
translate chinese confessional_right_mia_priest_act_change_c0ebe9d8:

    # player_name "They don't need to be suffocated by God's rules, instead show them how much you love them, like God loves everyone."
    player_name "他们不需要被神的规矩压得喘不过气，而是要让他们看到你多爱他们，就像神爱所有人。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:112
translate chinese confessional_right_mia_priest_act_change_9ac096bc:

    # player_name "You can't control everyone... But you can change yourself."
    player_name "你控制不了所有人……但你能改变自己。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:115
translate chinese confessional_right_mia_priest_act_change_a1662699:

    # helen "You're right... I will do what I can, {b}Father{/b}."
    helen "你说得对……我会尽力而为，{b}神父{/b}。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:118
translate chinese confessional_right_mia_priest_act_change_b5484872:

    # player_name "Now, go out and show some compassion and forgiveness just as the Lord forgives you."
    player_name "现在，出去展示怜悯与宽恕，就像主宽恕你一样。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:121
translate chinese confessional_right_mia_priest_act_change_f07fe346:

    # helen "Thank you for your insight... And forgiveness..."
    helen "谢谢你的开解……和宽恕……"


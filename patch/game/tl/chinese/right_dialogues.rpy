translate chinese confessional_right_mia_priest_act_change_9b6341c9:

    # player_name "No problem!"
    player_name "不客气！"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:126
translate chinese confessional_right_mia_priest_act_change_cf21649d_1:

    # helen "..."
    helen "……"


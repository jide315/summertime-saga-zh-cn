translate chinese confessional_right_mia_priest_act_pre_f787cbeb:

    # helen "{b}Father{/b}? Are you there?"
    helen "{b}神父{/b}？你在吗？"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:14
translate chinese confessional_right_mia_priest_act_pre_08567c0e:


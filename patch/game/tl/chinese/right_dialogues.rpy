    # helen "Forgive my family, Father, for they have sinned. It has been seven days since my last confession."
    helen "神父，请宽恕我的家人，因为他们犯了罪。我上次告解已是七天前。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:9
translate chinese confessional_right_mia_priest_act_pre_cf21649d:

    # helen "..."
    helen "……"


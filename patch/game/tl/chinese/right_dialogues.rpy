translate chinese confessional_right_mia_priest_act_pray_e923e9d4:

    # helen "Please ask the Lord to forgive them and could you pray for them too?"
    helen "请你求主宽恕他们，也请你为他们祈祷，好吗？"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:55
translate chinese confessional_right_mia_priest_act_pray_fe2de285:

    # player_name "Sure! Shouldn't be a big deal!"
    player_name "当然！这不算什么大事！"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:58
translate chinese confessional_right_mia_priest_act_pray_cf21649d_2:

    # helen "..."
    helen "……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:60
translate chinese confessional_right_mia_priest_act_pray_8c122b79:

    # helen "And what, dear {b}Father{/b}, would you have your faithful servant do as penance in my family's stead?"
    helen "那么，亲爱的{b}神父{/b}，你要你忠实的仆人代替我家人做什么苦修呢？"


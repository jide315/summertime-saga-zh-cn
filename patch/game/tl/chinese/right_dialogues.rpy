    player_name "{i}*咳嗽*{/i}"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:16
translate chinese confessional_right_mia_priest_act_pre_fa3316c2:

    # player_name "Yes... I uhh... I am listening..."
    player_name "是……我呃……我在听……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:19
translate chinese confessional_right_mia_priest_act_pre_7a146b1e:

    # helen "O Lord, I am heartily sorry for the way my family has offended you..."
    helen "哦主啊，我衷心悔恨我的家人冒犯了您……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:20
translate chinese confessional_right_mia_priest_act_pre_5a4c2057:

    # helen "... By my husband failing our marriage... And my daughter's whorish behavior..."
    helen "……我丈夫毁掉了我们的婚姻……我女儿又行为放荡……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:21
translate chinese confessional_right_mia_priest_act_pre_ebe4c173:

    # helen "I've tried feverishly to make them see their errors."
    helen "我竭尽全力想让他们看清自己的错。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:22
translate chinese confessional_right_mia_priest_act_pre_fdf47fd0:

    # helen "I've instructed them that they were headed to hell if they didn't change."
    helen "我告诫过他们，若不悔改就要下地狱。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:23
translate chinese confessional_right_mia_priest_act_pre_7ea075ac:

    # helen "... But it seems they've lost the holy path and succumbed to darkness."
    helen "……可他们似乎偏离了圣道，堕入了黑暗。"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:25
translate chinese confessional_right_mia_priest_act_pre_3c30bd9f:

    # helen "What should I do, {b}Father{/b}?"
    helen "我该怎么办，{b}神父{/b}？"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:31
translate chinese confessional_right_mia_priest_act_pray_5f81a682:

    # player_name "Perhaps you could... Err... Pray?"
    player_name "也许你可以……呃……祈祷？"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:34
translate chinese confessional_right_mia_priest_act_pray_cf21649d:

    # helen "..."
    helen "……"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:36
translate chinese confessional_right_mia_priest_act_pray_2c811202:

    # helen "Pray?"
    helen "祈祷？"

# lib/windows-i686/scripts/locations/church/confessional/right_dialogues.rpyc:39
translate chinese confessional_right_mia_priest_act_pray_6b968d9c:


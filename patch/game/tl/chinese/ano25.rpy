    # tony "She'll be fine in a couple days."
    tony "过几天就好了。"

# lib/windows-i686/scripts/locations/pizzeria/interior/dialogue/ano25.rpyc:398
translate chinese ano25_init_pizzeria_interior_53bd60dc:

    # anon f_normal "Oh."
    anon f_normal "哦。"


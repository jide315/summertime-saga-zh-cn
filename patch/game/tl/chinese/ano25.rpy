translate chinese ano25_init_pizzeria_interior_44e7195c:

    # tony "But it means {b}you gotta go and pick up the gear for the bank job{/b}."
    tony "但这就意味着{b}得你去把抢银行的装备取来{/b}。"

# lib/windows-i686/scripts/locations/pizzeria/interior/dialogue/ano25.rpyc:400

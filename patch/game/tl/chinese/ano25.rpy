    # anon f_confused @ -m_talk "Hmm?"
    anon f_confused @ -m_talk "嗯？"

# lib/windows-i686/scripts/locations/pizzeria/interior/dialogue/ano25.rpyc:401
translate chinese ano25_init_pizzeria_interior_dfa58020:

    # anon "Why?"
    anon "为什么？"


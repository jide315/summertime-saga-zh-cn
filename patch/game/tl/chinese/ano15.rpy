# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:4
translate chinese ano15_init_rump_front_5f715f5b:

    # anon "What the-"
    anon "什么鬼——"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:5
translate chinese ano15_init_rump_front_5f6a4de5:

    # anon f_skeptical "Who are those people outside {b}Mayor Rump{/b}'s house?"
    anon f_skeptical "{b}朗普市长{/b}家外面那些人是谁？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:7
translate chinese ano15_init_rump_front_35ae5a82:

    # anon "Are those reporters?!"
    anon "那些是记者吗？！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:8
translate chinese ano15_init_rump_front_f1fc8108:

    # anon f_normal "... I should check this out!"
    anon f_normal "……我该去看看！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:16
translate chinese ano15_init_rump_front_76c1ab84:

    # reporter1 "So it's been business as usual down at town hall then?"
    reporter1 "那市政厅那边还是一切照常？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:17
translate chinese ano15_init_rump_front_df968ddb:

    # rump "If making Summerville great again is business as usual, then I'd have to say yes."
    rump "如果把让萨默维尔再次伟大叫一切照常，那我得说是的。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:18
translate chinese ano15_init_rump_front_e0b9ecd9:

    # rump f_smirk "We've just completed construction on a brand new low income housing complex on the South Side..."
    rump f_smirk "我们刚在南区建成了一片全新的低收入住宅区……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:19
translate chinese ano15_init_rump_front_eb135892:

    # rump f_normal @ f_lips a_finger "... And we plan on implementing several more improvements to our fair city over the coming months."
    rump f_normal @ f_lips a_finger "……我们还计划在未来几个月里给我们这座美丽的城市带来更多改进。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:20
translate chinese ano15_init_rump_front_b921b2f8:

    # rump "Thus creating dozens, if not hundreds, of new jobs and stimulating the economy."
    rump "从而创造几十甚至上百个新工作岗位，刺激经济。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:21
translate chinese ano15_init_rump_front_8e522a94:

    # reporter2 "What kind of improvements?"
    reporter2 "什么样的改进？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:22
translate chinese ano15_init_rump_front_406a6951:

    # rump @ a_hand f_smirk "Personally, I'm hoping for a combination FroYo and tanning salon."
    rump @ a_hand f_smirk "我个人希望开一家兼做冻酸奶和美黑沙龙的地方。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:23
translate chinese ano15_init_rump_front_2025ec36:

    # rump "{i}*Ahem*{/i} However, I am not at liberty to divulge our exact plans at this time."
    rump "{i}*咳咳*{/i} 不过，目前我无权透露我们的具体计划。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:24
translate chinese ano15_init_rump_front_caddbc6a:

    # reporter3 "Sir, do you have any comments on the reports of your family's strange and/or uncouth behavior within the confines of your estate?"
    reporter3 "先生，有报道称您家人在您的宅邸内有怪异甚至粗俗的行为，您对此有何回应？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:25
translate chinese ano15_init_rump_front_601f11d7:

    # rump f_angry "No comment whatsoever."
    rump f_angry "无可奉告。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:26
translate chinese ano15_init_rump_front_3ba54698:

    # rump "Those reports are nothing but hearsay and lies!"
    rump "那些报道全是道听途说和谎言！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:28
translate chinese ano15_init_rump_front_2f0c5d02:

    # reporter3 "What about the nearly half-dozen lawsuits currently being brought against you by former employees?"
    reporter3 "那目前有近六名前雇员对您提起的诉讼呢？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:29
translate chinese ano15_init_rump_front_ac7ec83f:

    # rump f_normal @ f_lips "More lies from women just trying to make a quick buck."
    rump f_normal @ f_lips "又是些想捞快钱的女人编的谎话。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:30
translate chinese ano15_init_rump_front_298452eb:

    # rump "I assure you, I work very hard to ensure that anyone under my employ is paid a fair wage and treated with the utmost respect."
    rump "我向你们保证，我非常努力地确保我雇佣的每个人都拿到公平的报酬，并受到最大程度的尊重。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:31
translate chinese ano15_init_rump_front_0309ad3f:

    # rump f_smirk "As I'm sure you all will remember, I myself come from humble beginnings."
    rump f_smirk "大家肯定都记得，我本人出身卑微。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:32
translate chinese ano15_init_rump_front_b9ef4c16:

    # rump "Nobody knows better than I the stresses felt by the working class."
    rump "没人比我更了解工人阶级承受的压力。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:33
translate chinese ano15_init_rump_front_0c03bebe:

    # reporter1 "Wasn't your father also a multimillionaire?"
    reporter1 "您父亲不也是千万富翁吗？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:34
translate chinese ano15_init_rump_front_011c793c:

    # rump f_angry @ a_finger "Next question, please!"
    rump f_angry @ a_finger "下一个问题，谢谢！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:36
translate chinese ano15_init_rump_front_d66bf34b:

    # reporter2 "There has been a large influx in crime here in Summerville over the past few months..."
    reporter2 "过去几个月，萨默维尔的犯罪率大幅上升……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:37
translate chinese ano15_init_rump_front_31b5dc01:

    # reporter2 "... And citizens are beginning to grow concerned that our police force is being overwhelmed."
    reporter2 "……市民们开始担心我们的警力不堪重负。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:38
translate chinese ano15_init_rump_front_edd80616:

    # rump @ -m_talk "Mhmm."
    rump @ -m_talk "嗯哼。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:39
translate chinese ano15_init_rump_front_5d75e1cc:

    # reporter2 "Are there any plans to increase the funding or seek outside help?"
    reporter2 "有增加拨款或寻求外部援助的计划吗？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:40
translate chinese ano15_init_rump_front_b65fd692:

    # rump "Yes, I'm aware of the situation, having profited from it myself only recent-"
    rump "是的，我很清楚这个情况，毕竟我自己最近还从中获利——"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:43
translate chinese ano15_init_rump_front_11aa1c48:

    # rump f_suspicious @ f_suspicious_down "Err--I mean... Having felt the strain of the criminal activities myself."
    rump f_suspicious @ f_suspicious_down "呃——我是说……我自己也感受到了犯罪活动的压力。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:44
translate chinese ano15_init_rump_front_15f428f8:

    # reporter3 "Did you just say you profited from it?"
    reporter3 "您刚才是说自己从中获利了吗？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:45
translate chinese ano15_init_rump_front_fd49cdad:

    # rump f_angry "Of course not!"
    rump f_angry "当然没有！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:46
translate chinese ano15_init_rump_front_2203a5eb:

    # rump f_smirk @ f_lips a_hand "I just misspoke is all."
    rump f_smirk @ f_lips a_hand "我只是说错话了而已。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:47
translate chinese ano15_init_rump_front_48ba1a44:

    # rump "You'll have to forgive me, it's been a busy week and I'm quite tired."
    rump "请你们见谅，这周很忙，我相当累。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:49
translate chinese ano15_init_rump_front_91db018c:

    # rump "My office has been looking into ways we can further combat these criminals and I assure you we're doing all we can."
    rump "我的办公室一直在研究如何进一步打击这些罪犯，我保证我们正在竭尽所能。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:50
translate chinese ano15_init_rump_front_1242227c:

    # rump "It's very important to me that the brave men and women in our local law enforcement are given the tools and support they need to succeed."
    rump "让本地执法部门的英勇男女获得成功所需的工具和支持，对我来说非常重要。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:51
translate chinese ano15_init_rump_front_b00a8036:

    # rump f_normal "I've got these criminals in my crosshairs, I can promise you that!"
    rump f_normal "这些罪犯已经在我瞄准镜里了，我向你们保证！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:52
translate chinese ano15_init_rump_front_979a4d96:

    # rump f_smirk "Now, if you'll excuse me..."
    rump f_smirk "好了，恕我失陪……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:56
translate chinese ano15_init_rump_front_d00425f3:

    # rump "... I have a tee time with our City Planner."
    rump "……我跟我们的城市规划师约了打高尔夫。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:58
translate chinese ano15_init_rump_front_91bb397a:

    # reporter3 "What about the rumors regarding unidentified ships docking along the coast just outside our city?"
    reporter3 "那关于有不明船只在我们城外海岸停靠的传言呢？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:59
translate chinese ano15_init_rump_front_701b78fe:

    # reporter2 "{b}Mr. Mayor{/b}, please, just one more question!"
    reporter2 "{b}市长先生{/b}，拜托，再问一个问题！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:64
translate chinese ano15_init_rump_front_eb780b0f:

    # anon @ -m_talk "..."
    anon @ -m_talk "……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:65
translate chinese ano15_init_rump_front_1110ee72:

    # anon @ -m_talk "( He doesn't seem like a very genuine person... )"
    anon @ -m_talk "（他看起来不像个真诚的人……）"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:66
translate chinese ano15_init_rump_front_05cb61cb:

    # anon @ -m_talk "( ... Like, at all. )"
    anon @ -m_talk "（……一点都不像。）"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:67
translate chinese ano15_init_rump_front_e75a78c3:

    # erik "{b}[firstname]{/b}!!"
    erik "{b}[firstname]{/b}！！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:68
translate chinese ano15_init_rump_front_7fe6a8f9:

    # anon f_surprised @ -m_talk "Hmm?"
    anon f_surprised @ -m_talk "嗯？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:70
translate chinese ano15_init_rump_front_b89ccc20:

    # anon f_normal "{b}Erik{/b}?"
    anon f_normal "{b}埃里克{/b}？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:71
translate chinese ano15_init_rump_front_e3a79ed2:

    # erik "Hey, man!"
    erik "嘿，哥们！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:72
translate chinese ano15_init_rump_front_61352a8e:

    # anon "What are you doing here?"
    anon "你在这儿干什么？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:73
translate chinese ano15_init_rump_front_5445988f:

    # erik "Oh, nothing really..."
    erik "哦，没什么……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:74
translate chinese ano15_init_rump_front_a1ebd2c2:

    # erik "... Just walking home from {b}Glazie's{/b}."
    erik "……刚从{b}格雷齐店{/b}走回家。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:75
translate chinese ano15_init_rump_front_225b0044:

    # erik "You?"
    erik "你呢？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:76
translate chinese ano15_init_rump_front_45100dbe:

    # anon @ f_brag_closed a_point "I was scoping out {b}Mayor Rump{/b}'s interview."
    anon @ f_brag_closed a_point "我在看{b}朗普市长{/b}的采访。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:77
translate chinese ano15_init_rump_front_7b05f1e7:

    # erik "You were?"
    erik "你在看？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:78
translate chinese ano15_init_rump_front_8277b752:

    # erik "I didn't know you were into politics."
    erik "我不知道你对政治感兴趣。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:79
translate chinese ano15_init_rump_front_dfe31498:

    # anon @ f_worried "I'm not really."
    anon @ f_worried "其实我不感兴趣。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:80
translate chinese ano15_init_rump_front_1e1a7d53:

    # erik "Oh."
    erik "哦。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:88
translate chinese ano15_init_rump_front_30aee126:

    # erik "I still can't believe he won the election..."
    erik "我还是不敢相信他赢了大选……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:89
translate chinese ano15_init_rump_front_b63e30cd:

    # erik "... Pretty crazy, right?"
    erik "……挺疯狂的，对吧？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:93
translate chinese ano15_init_rump_front_eb780b0f_1:

    # anon @ -m_talk "..."
    anon @ -m_talk "……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:94
translate chinese ano15_init_rump_front_e76bd5cb:

    # erik f_woozy "My landlady says he looks like a giant cheese puff."
    erik f_woozy "我房东太太说他长得像个巨型芝士球。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:98
translate chinese ano15_init_rump_front_a3df1f9d:

    # anon @ -m_talk "Mhmm."
    anon @ -m_talk "嗯哼。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:99
translate chinese ano15_init_rump_front_c0b5815b:

    # erik f_normal @ f_laugh "I told her that's an insult to cheese puffs."
    erik f_normal @ f_laugh "我跟她说这是对芝士球的侮辱。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:101
translate chinese ano15_init_rump_front_c1f8b437:

    # erik @ f_woozy "I love cheese puffs."
    erik @ f_woozy "我爱芝士球。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:103
translate chinese ano15_init_rump_front_8e6bc97c:

    # erik f_worried "Are you alright, dude?"
    erik f_worried "你没事吧，哥们？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:104
translate chinese ano15_init_rump_front_4d745a1b:

    # anon f_worried a_idle @ -m_talk "Hmm?"
    anon f_worried a_idle @ -m_talk "嗯？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:105
translate chinese ano15_init_rump_front_27863a3c:

    # erik "You don't seem like your usual self."
    erik "你看起来不像平时的你。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:106
translate chinese ano15_init_rump_front_54b75998:

    # anon "Sorry, I just have a lot on my mind, you know?"
    anon "抱歉，我只是心事很多，你知道吗？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:107
translate chinese ano15_init_rump_front_bdaa736f:

    # erik "Yeah, I understand."
    erik "嗯，我理解。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:109
translate chinese ano15_init_rump_front_b10a3bb1:

    # erik f_normal "You wanna talk about it?"
    erik f_normal "想聊聊吗？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:110
translate chinese ano15_init_rump_front_14964dfe:

    # anon "Ehh, I'm not sure that's a good idea."
    anon "呃，我觉得这不是个好主意。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:111
translate chinese ano15_init_rump_front_5ed4172c:

    # erik @ f_laugh "Aww, c'mon!"
    erik @ f_laugh "哎呀，别这样！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:112
translate chinese ano15_init_rump_front_bb7472c4:

    # erik "What are friends for if not unburdening your problems?"
    erik "朋友不就是用来分担烦恼的吗？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:113
translate chinese ano15_init_rump_front_de7a59a8:

    # anon "I dunno, It's kinda dangerous..."
    anon "我不知道，这事挺危险的……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:114
translate chinese ano15_init_rump_front_61ed913b:

    # erik "Dude, you think I can't handle danger?!"
    erik "哥们，你觉得我应付不了危险？！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:115
translate chinese ano15_init_rump_front_16f3fa97:

    # erik a_proud "Need I remind you that I am a Warrior of Light, {b}[firstname]{/b}?"
    erik a_proud "需要我提醒你吗，我可是光明战士，{b}[firstname]{/b}？"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:116
translate chinese ano15_init_rump_front_7872329d:

    # erik "I've sworn my mighty hammer into the service of protecting the innocent!"
    erik "我已立誓用我的巨锤保护无辜者！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:117
translate chinese ano15_init_rump_front_f400794b:

    # anon @ f_skeptical -m_talk "..."
    anon @ f_skeptical -m_talk "……"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:118
translate chinese ano15_init_rump_front_b19181bf:

    # erik f_woozy "Why just last night, I charged into a goblin-infested cave and rescued a buxom maiden from-"
    erik f_woozy "就在昨晚，我冲进一个全是哥布林的洞穴，还从——救出了一位丰满的少女——"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:119
translate chinese ano15_init_rump_front_2ded39c0:

    # anon f_surprised @ a_up "Okay, okay... I'll tell you!"
    anon f_surprised @ a_up "行了行了……我告诉你！"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:120
translate chinese ano15_init_rump_front_fed00f71:

    # anon f_unimpressed "Just, calm down."
    anon f_unimpressed "你冷静点。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:121
translate chinese ano15_init_rump_front_5883ae6a:

    # erik "Erik the Mighty is always calm."
    erik "无敌的埃里克永远冷静。"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:123
translate chinese ano15_init_rump_front_4562d60b:

    # anon f_sad_down "{i}*Sigh*{/i}"
    anon f_sad_down "{i}*唉*{/i}"

# lib/windows-i686/scripts/locations/rump/dialogue/ano15.rpyc:124
translate chinese ano15_init_rump_front_1aacc976:

    # anon f_worried "I think {b}Mayor Rump{/b} might have been involved in my dad's death..."

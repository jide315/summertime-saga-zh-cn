# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:4
translate chinese ano22_sign_headstone_c89e5ce5:

    # anon "( Hmm, these flowers were put here only recently... )"
    anon "（嗯，这些花是最近才放下的……）"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:5
translate chinese ano22_sign_headstone_fa42b50d:

    # anon "( ... I wonder who brought them? )"
    anon "（……是谁带来的呢？）"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:6
translate chinese ano22_sign_headstone_d91a992e:

    # anon "..."
    anon "……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:7
translate chinese ano22_sign_headstone_c0ccc4c7:

    # anon "( I didn't think to bring him anything. )"
    anon "（我没想到给他带点什么。）"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:14
translate chinese ano22_sign_headstone_abd219a2:

    # anon "H-hey, {b}Dad{/b}."
    anon "嘿、嘿，{b}爸爸{/b}。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:16
translate chinese ano22_sign_headstone_b8ce384e:

    # anon "I'm sorry I didn't come and see you sooner."
    anon "抱歉我没早点来看你。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:17
translate chinese ano22_sign_headstone_a8644d95:

    # anon "I just-"
    anon "我只是——"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:19
translate chinese ano22_sign_headstone_ac00c714:

    # anon "I guess... I was afraid..."
    anon "我想……我是害怕……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:20
translate chinese ano22_sign_headstone_77917d25:

    # anon "... Of how this would make me feel."
    anon "……怕这让我难受。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:22
translate chinese ano22_sign_headstone_019b3063:

    # anon "So much has happened since..."
    anon "从那时起发生了好多事……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:23
translate chinese ano22_sign_headstone_4301c8ee:

    # anon "... Since you..."
    anon "……自从你……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:25
translate chinese ano22_sign_headstone_e8d187c5:

    # anon "{i}*Sigh*{/i} I still can't believe you're gone."
    anon "{i}*唉*{/i} 我还是不敢相信你走了。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:26
translate chinese ano22_sign_headstone_c76ce45b:

    # anon "I keep hoping that tomorrow I'll wake up to find that this has all been a bad dream..."
    anon "我总盼着明天醒来会发现这一切都是噩梦……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:27
translate chinese ano22_sign_headstone_75caf864:

    # anon "... And you'll be sitting at the breakfast table with your paper and coffee."
    anon "……而你会坐在早餐桌旁，拿着报纸和咖啡。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:28
translate chinese ano22_sign_headstone_b2c0f8e0:

    # anon "Annoying {b}[jen_name]{/b} with your silly dad jokes and trying to trick {b}[deb_name]{/b} into giving you answers for the crossword puzzle."
    anon "用你那些傻气的老爸笑话烦{b}[jen_name]{/b}，还想骗{b}[deb_name]{/b}给你填字游戏的答案。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:30
translate chinese ano22_sign_headstone_05f38815:

    # anon "Heh, things are so much different without you."
    anon "嘿，没有你，一切都不一样了。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:32
translate chinese ano22_sign_headstone_1367b9c1:

    # anon "I'm trying my best to keep things afloat, but honestly, I'm a poor substitute."
    anon "我在尽力撑着这个家，但说实话，我差得远。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:33
translate chinese ano22_sign_headstone_2a862f8f:

    # anon "{b}[jen_name]{/b} has been even bitchier than ever."
    anon "{b}[jen_name]{/b}比以前更婊了。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:35
translate chinese ano22_sign_headstone_fa48aa38:

    # anon "She'd never admit it but I think your passing hurt her a lot."
    anon "她绝不会承认，但我觉得你的离世让她很受伤。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:37
translate chinese ano22_sign_headstone_a6ae7afa:

    # anon "I've been trying to bond with her like you and {b}[deb_name]{/b} always wanted but she's not making things easy."
    anon "我一直在试着跟她亲近，就像你和{b}[deb_name]{/b}一直希望的那样，可她不好相处。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:41
translate chinese ano22_sign_headstone_eafec1cd:

    # anon "Heh, she's got this silly plan to make a bunch of money on the internet and you know how she is..."
    anon "嘿，她有个在网上赚大钱的傻计划，你知道她那人……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:42
translate chinese ano22_sign_headstone_a8cfd451:

    # anon "... Once she's made up her mind, there's no talking her out of it."
    anon "……一旦她下定决心，谁说都没用。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:44
translate chinese ano22_sign_headstone_e4066b35:

    # anon "But the crazy thing, is that it's actually working!"
    anon "但疯狂的是，居然真行得通！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:45
translate chinese ano22_sign_headstone_7d6039fd:

    # anon "She made a ton of money during our last show and she was actually smiling at the end!"
    anon "上次直播她赚了一大笔，最后她居然笑了！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:46
translate chinese ano22_sign_headstone_1afbfa93:

    # anon "I'm talking big, happy, almost giddy smiling... like she used to do when we were kids."
    anon "我说的是那种大大的、开心的、几乎傻笑的笑……像我们小时候那样。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:47
translate chinese ano22_sign_headstone_c08a4836:

    # anon "You should have seen her!"
    anon "你真该看看她！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:48
translate chinese ano22_sign_headstone_c15c7b2f:

    # anon "( !!! )"
    anon "（！！！）"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:49
translate chinese ano22_sign_headstone_10137e37:

    # anon "Err... well, maybe it's a good thing you couldn't..."
    anon "呃……也许你没看见是好事……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:50
translate chinese ano22_sign_headstone_8209ac3e:

    # anon "... Or at least I hope you couldn't."
    anon "……至少我希望你没看见。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:52
translate chinese ano22_sign_headstone_a7e260ea:

    # anon "I uhh... Heh."
    anon "我呃……嘿。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:53
translate chinese ano22_sign_headstone_bd838453:

    # anon "Never mind."
    anon "算了。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:55
translate chinese ano22_sign_headstone_d5ddcd30:

    # anon "The important thing is that she's getting along okay..."
    anon "重要的是她现在过得还行……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:56
translate chinese ano22_sign_headstone_faae96bd:

    # anon "... And who knows?!"
    anon "……谁知道呢？！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:57
translate chinese ano22_sign_headstone_b2b75bef:

    # anon "She might even start helping {b}[deb_name]{/b} out with the bills."
    anon "她说不定还会开始帮{b}[deb_name]{/b}付账单。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:58
translate chinese ano22_sign_headstone_45497c9a:

    # anon "So, that's great... Right?"
    anon "所以，这挺好……对吧？"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:60
translate chinese ano22_sign_headstone_8af08c8b:

    # anon "Oh, and speaking of {b}[deb_name]{/b}..."
    anon "哦，说到{b}[deb_name]{/b}……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:61
translate chinese ano22_sign_headstone_89f6b58f:

    # anon "... She's been a rock through this whole thing."
    anon "……这整件事里她一直很坚强。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:62
translate chinese ano22_sign_headstone_b8275fad:

    # anon "You'd really be proud of her, {b}Dad{/b}."
    anon "你一定会为她骄傲的，{b}爸爸{/b}。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:65
translate chinese ano22_sign_headstone_1a493dec:

    # anon "She always makes sure to put on a brave face for {b}[jen_name]{/b} and my sake..."
    anon "她总是为{b}[jen_name]{/b}和我强装坚强……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:66
translate chinese ano22_sign_headstone_f11abeb4:

    # anon "... Even though deep down, I can tell she's a wreck over losing you."
    anon "……尽管我知道，失去你让她心里碎成了一片。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:68
translate chinese ano22_sign_headstone_95ea0229:

    # anon "I've been making an effort and help her around the house more often and assure her that everything is gonna be okay..."
    anon "我一直在努力，多帮她做家务，安慰她一切都会好起来……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:69
translate chinese ano22_sign_headstone_0ca49910:

    # anon "... And it seems like it's working."
    anon "……看起来有成效。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:70
translate chinese ano22_sign_headstone_50f01f57:

    # anon "She's slowly but surely starting to mend and show flashes of her old self."
    anon "她正慢慢但确实地恢复，偶尔露出从前的样子。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:72
translate chinese ano22_sign_headstone_78e6dc36:

    # anon "But things have also gotten a little... umm..."
    anon "但事情也变得有点……唔……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:73
translate chinese ano22_sign_headstone_760166bd:

    # anon "... Complicated."
    anon "……复杂。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:75
translate chinese ano22_sign_headstone_a454fd2c:

    # anon "A-and it's not something I'm going to apologize for!"
    anon "而、而且我不会为此道歉！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:76
translate chinese ano22_sign_headstone_eb26731c:

    # anon "Because it just sort of happened on its own..."
    anon "因为那就是自然而然发生的……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:78
translate chinese ano22_sign_headstone_46d2b20a:

    # anon "... And {b}[deb_name]{/b} deserves to be happy and so do I... even if it's just in the here and now."
    anon "……{b}[deb_name]{/b}值得幸福，我也是……哪怕只是此时此刻。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:79
translate chinese ano22_sign_headstone_dc9ee00a:

    # anon "Right?"
    anon "对吧？"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:82
translate chinese ano22_sign_headstone_689ce4b4:

    # anon "{i}*Sigh*{/i} I really don't think I could have made it through this without her..."
    anon "{i}*唉*{/i} 我真的觉得没有她我撑不过来……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:83
translate chinese ano22_sign_headstone_ace4250d:

    # anon "... She's amazing!"
    anon "……她太棒了！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:86
translate chinese ano22_sign_headstone_4ce822ee:

    # anon "I should probably tell you about my new friends, {b}Tony{/b} and {b}Maria{/b}."
    anon "我大概该跟你说说我的新朋友，{b}托尼{/b}和{b}玛丽亚{/b}。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:87
translate chinese ano22_sign_headstone_c2c16234:

    # anon "They've been helping me try and get to the bottom of this whole mess you left us."
    anon "他们一直在帮我查清你留给我们的这摊烂事。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:89
translate chinese ano22_sign_headstone_257fba59:

    # anon "You would have liked {b}Tony{/b}, I think."
    anon "我想你会喜欢{b}托尼{/b}的。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:90
translate chinese ano22_sign_headstone_989dc030:

    # anon "He shares your sense of humor."
    anon "他跟你一样有幽默感。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:92
translate chinese ano22_sign_headstone_8df53a7a:

    # anon "And his wife {b}Maria{/b} is one of the strongest and most beautiful women I've ever met."
    anon "他妻子{b}玛丽亚{/b}是我见过最坚强、最漂亮的女人之一。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:93
translate chinese ano22_sign_headstone_97a5eb5e:

    # anon "A couple of these big goons came by their store a while back and she chased them away all on her own... at gunpoint no less!"
    anon "前阵子几个大块头打手来他们店里，她一个人就把他们赶走了……还是拿枪指着！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:94
translate chinese ano22_sign_headstone_f79e76c0:

    # anon "You should have seen the size of this shotgun she brought out... it was bigger than she was!"
    anon "你真该看看她掏出的那把霰弹枪有多大……比她还长！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:95
translate chinese ano22_sign_headstone_7797e437:

    # anon "Heh, they practically pooped themselves!"
    anon "嘿，他们差点吓出屎来！"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:98
translate chinese ano22_sign_headstone_4cb5bca6:

    # anon "Anyways, they're the ones who worked out exactly who you got mixed up with..."
    anon "总之，是他们查清了你到底卷进了谁的事……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:99
translate chinese ano22_sign_headstone_e464382c:

    # anon "... This {b}Raz Chernyshevsky{/b} and his Russian minions."
    anon "……这个{b}拉兹·切尔尼雪夫斯基{/b}和他的俄罗斯爪牙。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:100
translate chinese ano22_sign_headstone_4b6a3653:

    # anon "Oh, and {b}Mayor Rump{/b}, of course."
    anon "哦，当然还有{b}朗普市长{/b}。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:101
translate chinese ano22_sign_headstone_e0172ff2:

    # anon "Who, I'm sure you'll be happy to learn, is now behind bars."
    anon "我确定你会高兴知道，他现在在坐牢。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:103
translate chinese ano22_sign_headstone_cf79ecfd:

    # anon "Hopefully, you can rest a little easier knowing that."
    anon "希望知道这个你能安心一点。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:105
translate chinese ano22_sign_headstone_8468a088:

    # anon "I wanted to get {b}Raz{/b} too... but..."
    anon "我也想抓住{b}拉兹{/b}……可是……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:106
translate chinese ano22_sign_headstone_80a6683e:

    # anon "... Things are getting really dangerous now and he's pulled his entire organization back into their warehouse."
    anon "……现在事情变得很危险，他把整个组织都撤回仓库了。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:108
translate chinese ano22_sign_headstone_ec9b4200:

    # anon "{b}Tony{/b} wants to keep going but {b}Maria{/b} is starting to get really worried."
    anon "{b}托尼{/b}想继续，可{b}玛丽亚{/b}开始非常担心。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:109
translate chinese ano22_sign_headstone_60ac15e7:

    # anon "And I can't blame her to be honest."
    anon "说实话，我不怪她。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:111
translate chinese ano22_sign_headstone_db290916:

    # anon "We've got no way inside and no idea how many goons will be waiting for us."
    anon "我们没法进去，也不知道会有多少打手等着我们。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:112
translate chinese ano22_sign_headstone_4dcca3be:

    # anon "And they've only just had a baby... so, I really don't feel good about putting {b}Tony{/b} in danger."
    anon "而且他们刚有了孩子……所以让{b}托尼{/b}去冒险，我心里很不安。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:114
translate chinese ano22_sign_headstone_3c28888f:

    # anon "By the way, you're technically the grandfather..."
    anon "顺便说一句，严格说你是祖父了……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:115
translate chinese ano22_sign_headstone_828a528d:

    # anon "... So, umm... congratulations... I think?"
    anon "……所以，唔……恭喜……大概？"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:116
translate chinese ano22_sign_headstone_30a2d1d5:

    # anon "Heh, I just wish you were here to see it."
    anon "嘿，我只希望你能在这儿亲眼看到。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:118
translate chinese ano22_sign_headstone_4f4b6ac4:

    # anon "{i}*Sigh*{/i} {b}Maria{/b} says we've accomplished enough."
    anon "{i}*唉*{/i} {b}玛丽亚{/b}说我们已经做得够多了。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:119
translate chinese ano22_sign_headstone_668ab247:

    # anon "That you wouldn't want me to risk my life for revenge."
    anon "说你不会想让我为复仇冒生命危险。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:120
translate chinese ano22_sign_headstone_f19d37a4:

    # anon "And deep down, I know she's right."
    anon "内心深处，我知道她是对的。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:121
translate chinese ano22_sign_headstone_08509d04:

    # anon "You wouldn't want that for me."
    anon "你不会希望我那样。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:123
translate chinese ano22_sign_headstone_31c85730:

    # anon "But I just-"
    anon "可我只是——"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:125
translate chinese ano22_sign_headstone_f4342c7f:

    # anon "It makes me feel sick, you know?"
    anon "这让我恶心，你知道吗？"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:126
translate chinese ano22_sign_headstone_cace895a:

    # anon "Our family won't ever be the same because of this guy..."
    anon "因为这个家伙，我们家再也回不去了……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:127
translate chinese ano22_sign_headstone_e212c0e3:

    # anon "... I'm never going to see you again."
    anon "……我再也见不到你了。"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:129
translate chinese ano22_sign_headstone_58bf36d0:

    # anon "There has to be something we can do..."
    anon "一定有什么我们能做的……"

# lib/windows-i686/scripts/locations/church/graveyard/dialogue/ano22.rpyc:130

    # erik "The boobies!"
    erik "那对奶子鸟！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:32
translate chinese ano28_dink_dink_d75136db:

    # anon f_confused "B-boobies?"
    anon f_confused "奶、奶子鸟？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:33
translate chinese ano28_dink_dink_0a0b9ed6:

    # erik "The two birds you just chased off!"
    erik "你刚赶走的那两只鸟！"


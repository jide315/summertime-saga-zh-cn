translate chinese ano28_dink_dink_ed0845b4:

    # erik "They were a beautiful pair of blue-footed boobies... majestic, really."
    erik "那可是对漂亮的蓝脚鲣鸟……真的，很有气势。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:37
translate chinese ano28_dink_dink_20a7665b:

    # anon f_skeptical "Are you being serious right now?"
    anon f_skeptical "你现在是认真的吗？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:38
translate chinese ano28_dink_dink_02f8ae3f:

    # anon "I can't tell with you sometimes..."
    anon "我有时候真搞不懂你……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:40
translate chinese ano28_dink_dink_f2ef639e:

    # erik "I'm always serious when it comes to boobies, dude."
    erik "说到奶子鸟我可是很认真的，老兄。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:41
translate chinese ano28_dink_dink_415bafb7:

    # anon f_confused "So you really do bird watch?"
    anon f_confused "所以你真的在观鸟？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:43
translate chinese ano28_dink_dink_fa59caaf:

    # erik "Yeah, I told you that..."
    erik "是啊，我跟你说过……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:44
translate chinese ano28_dink_dink_e982620a:

    # anon "Okay, but I thought that was a euphemism for perving on girls."
    anon "好吧，但我以为那是偷看女生的委婉说法。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:45
translate chinese ano28_dink_dink_2d3b1bd4:

    # erik f_sad "What? No."
    erik f_sad "什么？不是。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:46
translate chinese ano28_dink_dink_884bcf2d:

    # erik "I really bird watch."
    erik "我真的观鸟。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:48
translate chinese ano28_dink_dink_3d2a36e0:

    # erik "Sheesh, man... you make it seem like I'm some aggressive, socially incompetent loser or something..."
    erik "天，老兄……你把我弄得像个有攻击性的社交废物似的……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:49
translate chinese ano28_dink_dink_dcdc1353:

    # anon f_thinking "I umm..."
    anon f_thinking "我呃……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:51
translate chinese ano28_dink_dink_ee5157b9:

    # anon f_worried @ f_confused "... Sorry?"
    anon f_worried @ f_confused "……抱歉？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:52
translate chinese ano28_dink_dink_c3d9b227:

    # erik f_angry "Yeah, you should be sorry."
    erik f_angry "嗯，你该道歉。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:53
translate chinese ano28_dink_dink_db2402f7:

    # erik "Boobies like that don't come along every day, you know?"
    erik "那样的奶子鸟可不是天天都有的，你知道吗？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:55
translate chinese ano28_dink_dink_0a48d4ed:

    # erik f_normal "What are you doing out here anyways?"
    erik f_normal "话说你在这外面干什么？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:56
translate chinese ano28_dink_dink_89586863:

    # anon "I found a message from my dad and I think he might have left something here."
    anon "我找到了我爸留的一条信息，我觉得他可能在这儿留了什么东西。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:57
translate chinese ano28_dink_dink_7f7d4b48:

    # erik f_worried "Like what?"
    erik f_worried "留了什么？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:58
translate chinese ano28_dink_dink_8cf0499c:

    # anon f_normal "Heh, I don't know... I was just about to check before you started yelling about boobies."
    anon f_normal "嘿，我不知道……我正要查的时候你就开始为奶子鸟大喊大叫。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:59
translate chinese ano28_dink_dink_f6f30adb:

    # erik "Oh, right."
    erik "哦，对。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:61
translate chinese ano28_dink_dink_b9614844:

    # erik f_normal "Well, don't let me stop you."
    erik f_normal "那就别因为我停下。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:64
translate chinese ano28_dink_dink_6fd5ab02:

    # anon "It's probably just another dead end... my father wasn't the best at planning-"
    anon "大概又是条死路……我爸不太会做计划——"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:69
translate chinese ano28_dink_dink_3eab9225:

    # erik "Whoa!"
    erik "哇！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:70
translate chinese ano28_dink_dink_eb4f49c7:

    # erik "Is that-"
    erik "那是——"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:72
translate chinese ano28_dink_dink_ac5f9504:

    # anon "!!!" with hpunch
    anon "！！！" with hpunch

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:73
translate chinese ano28_dink_dink_36e18646:

    # anon "That looks like money!!"
    anon "那看起来像钱！！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:87
translate chinese ano28_dink_dink_82bd5030:

    # anon f_surprised "A lot of money!"
    anon f_surprised "很多钱！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:88
translate chinese ano28_dink_dink_8bd2a7fd:

    # erik f_surprised -m_talk "Is it real?!"
    erik f_surprised -m_talk "是真的？！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:90
translate chinese ano28_dink_dink_040a88e0:

    # erik f_surprised_down "Lemme see!"
    erik f_surprised_down "让我看看！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:100
translate chinese ano28_dink_dink_3e5c1194:

    # erik "Holy crap, dude!!"
    erik "我靠，老兄！！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:104
translate chinese ano28_dink_dink_1386437b:

    # erik "It is real!"
    erik "是真的！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:107
translate chinese ano28_dink_dink_28624384:

    # erik "How much do you think is in there?!"
    erik "你觉得里面有多少？！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:108
translate chinese ano28_dink_dink_dce76f9b:

    # anon f_surprised "I dunno..."
    anon f_surprised "我不知道……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:112
translate chinese ano28_dink_dink_97caa3de:

    # anon "... But these are hundreds, so it's gotta be a lot, right?"
    anon "……但这些是百元钞，那肯定很多，对吧？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:115
translate chinese ano28_dink_dink_639a7956:

    # erik f_normal "I mean, yeah..."
    erik f_normal "我是说，是啊……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:124
translate chinese ano28_dink_dink_2e4426f0:

    # erik "... I'd say half a million, at least."
    erik "……我至少说五十万。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:128
translate chinese ano28_dink_dink_d7fb788d:

    # erik f_normal "You're rich, dude!"
    erik f_normal "你发财了，老兄！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:129
translate chinese ano28_dink_dink_42b3ceac:

    # anon "Hey, there's a note here too."
    anon "嘿，这儿还有封信。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:138
translate chinese ano28_dink_dink_c0965f29:

    # anon "\"{b}[firstname]{/b},\""
    anon "“{b}[firstname]{/b}，”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:139
translate chinese ano28_dink_dink_f2d38405:

    # anon "\"I'm so sorry, my son... For everything.\""
    anon "“我很抱歉，我的儿子……为这一切。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:140
translate chinese ano28_dink_dink_9ce81d8f:

    # anon "\"There's nothing I can say or do to make up for the mistakes I've made over these last few months.\""
    anon "“过去这几个月我犯的错，我说什么都无法弥补。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:141
translate chinese ano28_dink_dink_c2c786a1:

    # anon f_sad_down "\"I've put not only my life, but the lives of you and those closest to us at risk\"..."
    anon f_sad_down "“我不只拿我自己的命冒险，还把你和我们最亲近的人的命都置于险境”……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:142
translate chinese ano28_dink_dink_bdf4409f:

    # anon "... \"And all because I had the poor judgement of entering into a partnership with the wrong people.\""
    anon "……“全因为我判断失误，跟不该合作的人合伙了。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:145
translate chinese ano28_dink_dink_00ca8dfc:

    # anon f_worried_low "\"I won't ask for your forgiveness because I know I don't deserve it\"..."
    anon f_worried_low "“我不会求你原谅，因为我知道我不配”……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:146
translate chinese ano28_dink_dink_c719419b:

    # anon "... \"But I hope that one day you'll at least understand why I had to keep all of this from you.\""
    anon "……“但我希望有一天你至少能理解，我为什么必须瞒着你这些。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:147
translate chinese ano28_dink_dink_ac458f78:

    # anon f_sad_down "\"There's nothing in this world more important than family, son.\""
    anon f_sad_down "“儿子，这世上没有什么比家人更重要。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:148
translate chinese ano28_dink_dink_d79c1ebb:

    # anon "\"My biggest regret in all of this is that I won't be around to see you start one of your own\"..."
    anon "“这一切里我最大的遗憾，是看不到你组建自己的家庭”……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:149
translate chinese ano28_dink_dink_e7dcfe39:

    # anon "... \"Or walk {b}[jen_name]{/b} down the aisle.\""
    anon "……“也看不到牵着{b}[jen_name]{/b}走进婚礼。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:150
translate chinese ano28_dink_dink_a82e94f2:

    # anon @ f_sad_smile_down -m_talk "{i}*Sniff*{/i}"
    anon @ f_sad_smile_down -m_talk "{i}*吸鼻子*{/i}"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:151
translate chinese ano28_dink_dink_61b66361:

    # anon "... \"Or grow old with {b}[deb_name]{/b}.\""
    anon "……“或者跟{b}[deb_name]{/b}一起变老。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:152
translate chinese ano28_dink_dink_2563acc9:

    # anon "\"They're your responsibility now.\""
    anon "“现在他们归你照顾了。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:153
translate chinese ano28_dink_dink_63c3f634:

    # anon f_worried_low "\"I believe you'll do a better job than I ever could\"..."
    anon f_worried_low "“我相信你会比我做得更好”……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:154
translate chinese ano28_dink_dink_5b1a186b:

    # anon "... \"And hopefully this money will help.\""
    anon "……“希望这笔钱能帮上忙。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:156
translate chinese ano28_dink_dink_00542739:

    # anon f_sad_down "\"You are my legacy, son.\""
    anon f_sad_down "“你是我的传承，儿子。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:157
translate chinese ano28_dink_dink_a82e94f2_1:

    # anon @ f_sad_smile_down -m_talk "{i}*Sniff*{/i}"
    anon @ f_sad_smile_down -m_talk "{i}*吸鼻子*{/i}"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:158
translate chinese ano28_dink_dink_aceb63cb:

    # anon "\"My greatest gift.\""
    anon "“我最珍贵的礼物。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:159
translate chinese ano28_dink_dink_3a53a558:

    # anon "\"I'm so very proud of the man you've become.\""
    anon "“我为你成为的这个男人无比骄傲。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:160
translate chinese ano28_dink_dink_a82e94f2_2:

    # anon @ f_sad_smile_down -m_talk "{i}*Sniff*{/i}"
    anon @ f_sad_smile_down -m_talk "{i}*吸鼻子*{/i}"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:161
translate chinese ano28_dink_dink_88c5f3c5:

    # anon "\"I will always be there, watching over you.\""
    anon "“我会一直在那儿，看着你。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:163
translate chinese ano28_dink_dink_94cfa6d7:

    # anon "\"With all the love in my heart, {b}Dad{/b}.\""
    anon "“满心的爱，{b}爸爸{/b}。”"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:167
translate chinese ano28_dink_dink_3333f159:

    # anon @ -m_talk "{i}*Sniff*{/i}"
    anon @ -m_talk "{i}*吸鼻子*{/i}"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:171
translate chinese ano28_dink_dink_3819d88f:

    # erik "Jesus, dude..."
    erik "天，老兄……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:175
translate chinese ano28_dink_dink_c2808c5b:

    # anon "Y-yeah."
    anon "是、是啊。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:176
translate chinese ano28_dink_dink_ed09f11c:

    # erik "I know that wasn't exactly the goodbye you wanted..."
    erik "我知道那不完全是你想要的告别……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:177
translate chinese ano28_dink_dink_4f0e2a44:

    # erik "... But it was pretty good."
    erik "……但挺好的。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:179
translate chinese ano28_dink_dink_24124986:

    # anon "{i}*Sniff*{/i} Yeah, it was."
    anon "{i}*吸鼻子*{/i} 是啊，挺好。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:183
translate chinese ano28_dink_dink_3314e7de:

    # erik f_sad_down "I mean, I'd kill to hear something like that from my dad..."
    erik f_sad_down "我是说，我宁愿拿命换我爸跟我说这种话……"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:185
translate chinese ano28_dink_dink_1fa4bb51:

    # erik f_nervous "... Should I like, hug you or-"
    erik f_nervous "……我该抱你一下还是——"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:186
translate chinese ano28_dink_dink_38f46698:

    # anon f_worried "Heh, no... that's alright."
    anon f_worried "嘿，不用……没关系。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:189
translate chinese ano28_dink_dink_0a00ab09:

    # anon "Thanks, though... I appreciate the sentiment."
    anon "不过谢谢……我领这份心意。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:190
translate chinese ano28_dink_dink_87b28d2d:

    # erik f_shy "No problem, dude."
    erik f_shy "不客气，老兄。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:195
translate chinese ano28_dink_dink_2dffffa0:

    # erik "So, ehh... what are you gonna do with the money?"
    erik "那，呃……这钱你打算怎么办？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:202
translate chinese ano28_dink_dink_a9340526:

    # anon "Well, I'll probably start by paying off {b}[deb_name]{/b}'s debt at the bank."
    anon "嗯，我大概先还清{b}[deb_name]{/b}在银行的债。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:210
translate chinese ano28_dink_dink_29155592:

    # anon "And I should probably give some to {b}Liu{/b}."
    anon "还有我大概该给{b}刘{/b}一些。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:211
translate chinese ano28_dink_dink_ebaf8401:

    # anon "She definitely needs it now that she's on her own."
    anon "她现在一个人，肯定需要。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:213
translate chinese ano28_dink_dink_0366957b:

    # erik f_nervous "Who's {b}Liu{/b}?"
    erik f_nervous "{b}刘{/b}是谁？"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:214
translate chinese ano28_dink_dink_78294722:

    # anon f_worried "She's the teller who's been helping me."
    anon f_worried "就是一直帮我的那个柜员。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:215
translate chinese ano28_dink_dink_b3e5522b:

    # anon "My dad and her were close, before he died."
    anon "我父亲去世前跟她很亲近。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:216
translate chinese ano28_dink_dink_11dcd365:

    # erik f_normal "Oh."
    erik f_normal "哦。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:217
translate chinese ano28_dink_dink_745b0226:

    # erik "Well, yeah... that sounds llke a nice thing to do."
    erik "嗯，是啊……听起来挺厚道的。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:220
translate chinese ano28_dink_dink_f43ad55f:

    # erik "Just make sure you keep enough for tuition next year."
    erik "只要留够明年的学费就行。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:221
translate chinese ano28_dink_dink_eaf0060d:

    # anon f_normal "Man, did you see how much is in here?!"
    anon f_normal "天，你看到这里面有多少了吗？！"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:222
translate chinese ano28_dink_dink_7b9910e3:

    # anon "I'll have plenty left over."
    anon "我会剩很多。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:229
translate chinese ano28_dink_dink_b3572d63:

    # erik "You should buy a boat."
    erik "你该买条船。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:235
translate chinese ano28_dink_dink_c352e69b:

    # anon "I have The Dink."
    anon "我有小丁丁号。"

# lib/windows-i686/scripts/locations/treehouse/dialogue/ano28.rpyc:241
translate chinese ano28_dink_dink_6e7a6421:


# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:58
translate chinese ano21_cops_police_office_b7620b98:

    # earl f_happy "Heh, I don't need luck {b}Harold{/b}."
    earl f_happy "嘿，我不需要运气，{b}哈罗德{/b}。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:64
translate chinese ano21_cops_police_office_52bab740:

    # earl "I just need a hot cup of joe and a couple of those jelly donuts from the break room!"
    earl "我只需要一杯热咖啡和休息室里的几个果冻甜甜圈！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:68
translate chinese ano21_cops_police_office_22c1ddda:

    # anon f_skeptical "Chief Lassard?"
    anon f_skeptical "拉萨德警长？"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:69
translate chinese ano21_cops_police_office_87ffe50d:

    # harold "He's trying to requisition some officers from up north to help us with our mafia problem."
    harold "他正想从北边调些警员来帮我们处理黑帮问题。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:70
translate chinese ano21_cops_police_office_9ea18d6d:

    # anon f_normal "Does that mean you guys are going to move on them soon?"
    anon f_normal "那是不是说你们很快就要对他们动手了？"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:71
translate chinese ano21_cops_police_office_72ae173d:

    # harold f_suspicious "\"Move on them?\""
    harold f_suspicious "“对他们动手？”"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:72
translate chinese ano21_cops_police_office_15c56091:

    # harold f_smirk "Where'd you learn to talk like that, kid?"
    harold f_smirk "你从哪儿学来这种话的，孩子？"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:73
translate chinese ano21_cops_police_office_86f13136:

    # anon f_unimpressed "Don't call me kid!"
    anon f_unimpressed "别叫我孩子！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:74
translate chinese ano21_cops_police_office_a99813f2:

    # anon f_shy @ a_behind_head "And I dunno... Cop shows on TV, I guess."
    anon f_shy @ a_behind_head "还有我也不知道……大概是电视上的警匪剧吧。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:75
translate chinese ano21_cops_police_office_d4bdbf74:

    # harold "Well, {b}[firstname]{/b}, I'm afraid I can't really give you a timeline yet."
    harold "呃，{b}[firstname]{/b}，恐怕我现在还没法给你时间表。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:76
translate chinese ano21_cops_police_office_17291393:

    # harold "We can't really proceed with anything until the Captain gets us some support."
    harold "在队长给我们弄到支援之前，我们没法采取任何行动。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:77
translate chinese ano21_cops_police_office_3b407c30:

    # anon "Yeah, but that shouldn't take too long, right?"
    anon "是啊，但那应该不用太久吧？"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:78
translate chinese ano21_cops_police_office_0c0b6bf1:

    # harold @ f_suspicious "I have no idea."
    harold @ f_suspicious "我不知道。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:79
translate chinese ano21_cops_police_office_940a5ed7:

    # harold "They could have guys down here in a few days or it could take months."
    harold "他们可能几天内就派人来，也可能要几个月。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:80
translate chinese ano21_cops_police_office_ef502572:

    # anon f_shock "Months?!"
    anon f_shock "几个月？！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:81
translate chinese ano21_cops_police_office_a6d813c7:

    # anon f_angry a_sides @ a_frustrated "My friends and I can't wait months for you guys to resolve this!"
    anon f_angry a_sides @ a_frustrated "我和我朋友可等不了几个月让你们解决这事！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:82
translate chinese ano21_cops_police_office_cb5ede2a:

    # harold f_concerned @ a_hands_up "I'm sure it won't take months."
    harold f_concerned @ a_hands_up "我肯定用不了几个月。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:83
translate chinese ano21_cops_police_office_c742184b:

    # harold "But you gotta understand that as of this moment, we are not staffed to take on an organization this large."
    harold "但你得明白，就目前而言，我们的人手不足以对付这么大的组织。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:84
translate chinese ano21_cops_police_office_3669faa2:

    # anon "So what am I supposed to do, {b}Harold{/b}?!"
    anon "那我该怎么办，{b}哈罗德{/b}？！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:85
translate chinese ano21_cops_police_office_14a062c6:

    # anon "They're threatening to kill us."
    anon "他们威胁要杀了我们。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:86
translate chinese ano21_cops_police_office_c7107ea3:

    # harold "That's not going to happen."
    harold "那不会发生。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:87
translate chinese ano21_cops_police_office_7b808a4e:

    # harold "You have my word."
    harold "我向你保证。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:88
translate chinese ano21_cops_police_office_0b8737c9:

    # harold "In fact, I'm assigning {b}Officer Yumi{/b} to look after you guys until this matter is resolved."
    harold "其实，我正派{b}由美警官{/b}去照看你们，直到这事解决。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:89
translate chinese ano21_cops_police_office_39a93c31:

    # harold "She's going to be outside your home twenty-four seven."
    harold "她会二十四小时守在你家外面。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:90
translate chinese ano21_cops_police_office_eb780b0f:

    # anon @ -m_talk "..."
    anon @ -m_talk "……"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:91
translate chinese ano21_cops_police_office_9b58f5bf:

    # harold "If we're lucky, this \"{b}Raz Putin{/b}\" character will realize he's vulnerable now with {b}Rump{/b} behind bars."
    harold "如果我们走运，这个“{b}拉兹·普京{/b}”会发现{b}朗普{/b}入狱后自己很脆弱。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:92
translate chinese ano21_cops_police_office_dfa24df2:

    # harold "He might even pack up his goons and flee the country."
    harold "他甚至可能收拾手下逃出国外。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:93
translate chinese ano21_cops_police_office_fc891eba:

    # anon "How would that be lucky?!"
    anon "那怎么算走运？！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:94
translate chinese ano21_cops_police_office_f38b85b3:

    # anon "They killed my dad and you want to let them get away with it?!"
    anon "他们杀了我爸，你还想让他们逍遥法外？！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:95
translate chinese ano21_cops_police_office_ceeb9bb9:

    # harold "Of course not, {b}[firstname]{/b}..."
    harold "当然不是，{b}[firstname]{/b}……"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:96
translate chinese ano21_cops_police_office_c3fdc60c:

    # harold "I wanna see these animals pay for their crimes just as much as you."
    harold "我跟你一样想看到这些禽兽为罪行付出代价。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:97
translate chinese ano21_cops_police_office_763fc814:

    # anon "Do you?"
    anon "是吗？"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:98
translate chinese ano21_cops_police_office_41b89b9f:

    # anon "Because you sure as hell haven't done much to prove it!"
    anon "因为你可真没做什么来证明！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:99
translate chinese ano21_cops_police_office_e23c0793:

    # harold f_angry a_hips "C'mon, that's not fair."
    harold f_angry a_hips "拜托，这不公平。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:100
translate chinese ano21_cops_police_office_ca5b3b10:

    # harold "We're doing everything we can to-"
    harold "我们在尽一切努力——"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:101
translate chinese ano21_cops_police_office_ca98bce7:

    # anon "You wouldn't have even gotten {b}Rump{/b} if I hadn't handed him to you on a silver platter!"
    anon "要不是我把{b}朗普{/b}双手奉上，你们根本抓不到他！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:103
translate chinese ano21_cops_police_office_3b5fc27b:

    # anon "{b}Tony{/b} was right about you guys being worthless..."
    anon "{b}托尼{/b}说得没错，你们就是废物……"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:105
translate chinese ano21_cops_police_office_06fc3578:

    # harold f_surprised a_hands_up "Hey, where are you going?"
    harold f_surprised a_hands_up "嘿，你去哪儿？"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:106
translate chinese ano21_cops_police_office_9b840e5b:

    # harold f_concerned "{b}[firstname]{/b}?!"
    harold f_concerned "{b}[firstname]{/b}？！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:109
translate chinese ano21_cops_police_office_694c48ca:

    # harold "Grr!"
    harold "呃！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:110
translate chinese ano21_cops_police_office_90709bb2:

    # harold f_angry "{b}Yumi{/b}!"
    harold f_angry "{b}由美{/b}！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:111
translate chinese ano21_cops_police_office_80cbb11e:

    # harold "I need you over here now!"
    harold "我需要你马上过来！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:113
translate chinese ano21_cops_police_office_e8a3d94b:

    # yumi "Sir?"
    yumi "长官？"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:114
translate chinese ano21_cops_police_office_bc732da9:

    # harold "I want you to get over to the Cummings residence ASAP and check on the family."
    harold "我要你立刻去卡明斯家，看看那家人。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:115
translate chinese ano21_cops_police_office_79ae2703:

    # yumi "Right away, sir!"
    yumi "马上，长官！"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:116
translate chinese ano21_cops_police_office_ff8f3907:

    # harold f_suspicious "And pack a bag."
    harold f_suspicious "再收拾个行李包。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:117
translate chinese ano21_cops_police_office_05346dad:

    # harold "You're gonna be there a while."
    harold "你要在那儿待一阵子。"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:122
translate chinese ano21_cops_police_office_b71429a0:

    # anon @ -m_talk "( {i}*Sigh*{/i} I can't believe, after all this... The Russians might just get away with it. )"
    anon @ -m_talk "（{i}*叹气*{/i} 真不敢相信，折腾这么久……俄罗斯人可能就这么逍遥法外。）"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:123
translate chinese ano21_cops_police_office_dfe19cbf:

    # anon @ -m_talk "( I can't let that happen. )"
    anon @ -m_talk "（我不能让这事发生。）"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:124
translate chinese ano21_cops_police_office_875e84ce:

    # anon @ -m_talk "( There has to be something I can do! )"
    anon @ -m_talk "（总得有点我能做的！）"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:125
translate chinese ano21_cops_police_office_9d01232f:

    # anon @ -m_talk "( Maybe {b}Tony{/b} will have an idea? )"
    anon @ -m_talk "（也许{b}托尼{/b}会有主意？）"

# lib/windows-i686/scripts/locations/police/office/dialogue/ano21.rpyc:126
translate chinese ano21_cops_police_office_6381ee93:

    # anon @ -m_talk "( {b}I should speak with him.{/b}} )"
    anon @ -m_talk "（{b}我该去跟他谈谈。{/b}）"

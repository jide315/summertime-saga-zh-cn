# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:220
translate chinese button_clyde_pink_beaver_dc477db7:

    # player_name "How come?"
    player_name "为什么？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:223
translate chinese button_clyde_pink_beaver_da006176:

    # clyde "{i}*Sigh*{/i} Let's just say ole {b}Jebadiah{/b} was a little, touched in the head, alright?"
    clyde "{i}*叹气*{/i} 这么说吧，老{b}杰巴迪亚{/b}脑子有点……不太正常，行了吧？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:226
translate chinese button_clyde_pink_beaver_637f9956:

    # player_name "Touched in the head?"
    player_name "脑子不太正常？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:229
translate chinese button_clyde_pink_beaver_08df8431:

    # clyde "You know."
    clyde "你懂的。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:230
translate chinese button_clyde_pink_beaver_08667dba:

    # clyde "He had a few screws loose."
    clyde "他少了几根螺丝。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:233
translate chinese button_clyde_pink_beaver_f3623c7b:

    # player_name "Uhh..."
    player_name "呃……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:236
translate chinese button_clyde_pink_beaver_8d969c63:

    # clyde "His wheel was turning but the hamster was dead."
    clyde "轮子还在转，可仓鼠早死了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:239
translate chinese button_clyde_pink_beaver_c0c9b323:

    # player_name "I don't..."
    player_name "我不……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:242
translate chinese button_clyde_pink_beaver_da21bb95:

    # clyde "He was a few cards short of a full deck."
    clyde "他一副牌少了好几张。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:245
translate chinese button_clyde_pink_beaver_fff48a75:

    # player_name "What are you talking about?!"
    player_name "你在说什么啊？！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:248
translate chinese button_clyde_pink_beaver_fb345c35:

    # clyde "Tch, he was nuttier than a porta-potty at a peanut festival, alright?!"
    clyde "啧，他比花生节上的移动厕所还疯，行了吧？！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:251
translate chinese button_clyde_pink_beaver_83efd866:

    # player_name "You mean he was crazy?"
    player_name "你是说他疯了？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:254
translate chinese button_clyde_pink_beaver_8c743bac:

    # clyde "That's what I've been tryin' to tell ya..."
    clyde "俺一直就在跟你说这个……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:257
translate chinese button_clyde_pink_beaver_6814f64f:

    # player_name "Oh."
    player_name "哦。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:260
translate chinese button_clyde_pink_beaver_f71580cc:

    # clyde "Yeah."
    clyde "嗯。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:261
translate chinese button_clyde_pink_beaver_0b3b2135:

    # clyde "Mama says he was always a bit eccentric."
    clyde "俺娘说他一直都有点古怪。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:262
translate chinese button_clyde_pink_beaver_526c4beb:

    # clyde "Folk in the holler used to call him the hillbilly wizard."
    clyde "山沟里的人以前都叫他乡巴佬巫师。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:265
translate chinese button_clyde_pink_beaver_977cc31c:

    # player_name "He was a wizard?"
    player_name "他是巫师？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:268
translate chinese button_clyde_pink_beaver_e673a920:

    # clyde "Yeah, but he wasn't a very good one."
    clyde "是啊，不过水平不怎么样。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:269
translate chinese button_clyde_pink_beaver_904868c7:

    # clyde "I remember, he tried turnin' me into a toad one time, 'cause I had gone and got my head stuck in the stairs."
    clyde "俺记得有一回，他想把俺变成蛤蟆，就因为俺脑袋卡在楼梯里了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:272
translate chinese button_clyde_pink_beaver_16f071de:

    # player_name "You got your head stuck in the stairs?!"
    player_name "你脑袋卡在楼梯里了？！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:275
translate chinese button_clyde_pink_beaver_848145d1:

    # clyde "My brother told me there was a leprechaun livin' under the stairs and I wanted to see him."
    clyde "俺哥跟俺说楼梯底下住着个小矮妖，俺就想去看。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:278
translate chinese button_clyde_pink_beaver_b3a532a8:

    # player_name "Pfft, hahaha!"
    player_name "噗，哈哈哈！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:281
translate chinese button_clyde_pink_beaver_2005dc68:

    # clyde "Anyways, his spell didn't work."
    clyde "反正他那咒语没灵。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:283
translate chinese button_clyde_pink_beaver_faf0a6a9:

    # clyde "So Mama had to grease me up with bacon fat and slide me out."
    clyde "结果俺娘只好拿培根油把俺抹了一遍，才把俺滑出来。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:286
translate chinese button_clyde_pink_beaver_ad9cd909:

    # player_name "Haha!"
    player_name "哈哈！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:289
translate chinese button_clyde_pink_beaver_dcc5ecdf:

    # clyde "Then there was this one time, I was failin' the second grade..."
    clyde "还有一回，俺二年级念不下去要留级……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:290
translate chinese button_clyde_pink_beaver_62310805:

    # clyde "... And grandpappy, he said, \"Don't you worry none little {b}Clyde{/b}. Grandpappy will fix it right up fer ya.\""
    clyde "……爷爷他就说：“别担心，小{b}克莱德{/b}。爷爷会给你搞定的。”"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:294
translate chinese button_clyde_pink_beaver_dd31d09f:

    # player_name "Okay, so what happened?"
    player_name "好吧，那后来怎么了？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:297
translate chinese button_clyde_pink_beaver_87214ec2:

    # clyde "Well, I don't rightly know. They found him in the school house, in the middle of the night, buck naked and covered in chicken blood."
    clyde "呃，俺也说不太清。大半夜的，他们发现他在校舍里，光溜溜的，浑身是鸡血。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:300
translate chinese button_clyde_pink_beaver_eca9a30f:

    # player_name "Chicken blood?!"
    player_name "鸡血？！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:303
translate chinese button_clyde_pink_beaver_6325713c:

    # clyde "Yeah, he said he was performin' some kinda ritual thingy to help me with my schoolin'."
    clyde "是啊，他说他在做什么仪式，好帮俺念书。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:304
translate chinese button_clyde_pink_beaver_00d8f994:

    # clyde "Apparently he was a hootin' and a hollerin' and a carryin' on."
    clyde "听说他当时又嚎又叫，闹得鸡飞狗跳。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:307
translate chinese button_clyde_pink_beaver_aa124279:

    # player_name "Yeah, he does sound a little crazy, {b}Clyde{/b}."
    player_name "嗯，听起来确实有点疯，{b}克莱德{/b}。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:310
translate chinese button_clyde_pink_beaver_3bf9b4dc:

    # clyde "Yeah, I reckon he was."
    clyde "嗯，俺也觉得他是。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:311
translate chinese button_clyde_pink_beaver_1eb96c6b:

    # clyde "He was a sweet ole feller though."
    clyde "不过他是个心善的老头儿。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:312
translate chinese button_clyde_pink_beaver_b604d632:

    # clyde "It's too bad all dem evil spirits got mad at him."
    clyde "可惜那些恶灵后来都跟他翻脸了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:315
translate chinese button_clyde_pink_beaver_912bfd26:

    # player_name "Evil spirits?"
    player_name "恶灵？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:318
translate chinese button_clyde_pink_beaver_309994b0:

    # clyde "Yeah, he told me all 'bout it right after he broke this here statue and hid the pieces."
    clyde "是啊，他把这尊雕像打碎、把碎片藏起来之后，就把一切都跟俺说了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:319
translate chinese button_clyde_pink_beaver_18bcb2c2:

    # clyde "Said they was coming fer him and he wanted her to be safe."
    clyde "他说那些东西冲他来了，他想让她平安。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:322
translate chinese button_clyde_pink_beaver_32919c58:

    # player_name "Her?"
    player_name "她？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:325
translate chinese button_clyde_pink_beaver_695ffb24:

    # clyde "The lady in the statue, of course!"
    clyde "当然是雕像里的那位女士啊！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:326
translate chinese button_clyde_pink_beaver_0ed2f0c9:

    # clyde "He was real tore up about hiding her away."
    clyde "把她藏起来这件事，让他难受得很。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:327
translate chinese button_clyde_pink_beaver_fa61590f:

    # clyde "She was his good luck charm after all."
    clyde "毕竟她是他的幸运符。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:330
translate chinese button_clyde_pink_beaver_300de43e:

    # player_name "Weird."
    player_name "真怪。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:333
translate chinese button_clyde_pink_beaver_2d6a0394:

    # clyde "Then we caught him fornicatin' with the livestock and Mama sent him off to the nuthouse."
    clyde "后来我们撞见他在跟牲口乱搞，俺娘就把他送进疯人院了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:336
translate chinese button_clyde_pink_beaver_21da4306:

    # player_name "!!!" with hpunch
    player_name "！！！" with hpunch

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:338
translate chinese button_clyde_pink_beaver_b9096bb1:

    # player_name "You mean he-"
    player_name "你是说他——"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:339
translate chinese button_clyde_pink_beaver_48b98209:

    # player_name "W-with animals?!"
    player_name "跟、跟动物？！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:343
translate chinese button_clyde_pink_beaver_91e1a9d1:

    # clyde "{i}*Sigh*{/i} Yup, crying like a baby too."
    clyde "{i}*叹气*{/i} 对，还哭得跟个娃似的。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:344
translate chinese button_clyde_pink_beaver_0e2d7951:

    # clyde "Them spirits musta really done a number on him, poor feller."
    clyde "那些恶灵八成真把他折腾惨了，可怜的老头。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:347
translate chinese button_clyde_pink_beaver_23ca8ad8:

    # player_name "So uhh..."
    player_name "那么，呃……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:348
translate chinese button_clyde_pink_beaver_ba8df918:

    # player_name "... Is your grandpa still living at the nuthouse then?"
    player_name "……那你爷爷现在还住在疯人院吗？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:351
translate chinese button_clyde_pink_beaver_3d70c665:

    # clyde "Ah, nah."
    clyde "啊，没有了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:352
translate chinese button_clyde_pink_beaver_86c44283:

    # clyde "About two weeks after Mama sent him there, his room caught on fire and he burnt up in it."
    clyde "俺娘把他送过去大概两个礼拜后，他房间着了火，他就被烧死在里面了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:355
translate chinese button_clyde_pink_beaver_29c0bf9d:

    # player_name "Jesus..."
    player_name "老天啊……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:357
translate chinese button_clyde_pink_beaver_18bae4e0:

    # clyde "They not sure how the fire started but I reckon them spirits finally got him."
    clyde "他们没查清火是怎么起的，不过俺想是那些恶灵终于把他带走了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:359
translate chinese button_clyde_pink_beaver_dfdc89b5:

    # player_name "I don't even..."
    player_name "我简直……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:360
translate chinese button_clyde_pink_beaver_cc70aff3_1:

    # player_name "..."
    player_name "……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:362
translate chinese button_clyde_pink_beaver_1d0686ba:

    # clyde "Yeah, it was real sad..."
    clyde "是啊，真让人难过……"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:367
translate chinese button_clyde_pink_beaver_dad9fef0:

    # clyde "Anyways!"
    clyde "不说这个了！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:370
translate chinese button_clyde_pink_beaver_7b2e3781:

    # clyde "I reckon he wouldn't mind me giving you this piece of the statue."
    clyde "俺想他不会介意俺把这块雕像碎片给你。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:371
translate chinese button_clyde_pink_beaver_16d241f7:

    # clyde "Seein' as you helped me and all."
    clyde "毕竟你帮了俺嘛。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:372
translate chinese button_clyde_pink_beaver_a287ab1b:

    # clyde "Who knows, maybe it'll bring you luck too."
    clyde "谁知道呢，说不定它也能给你带来好运。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:375
translate chinese button_clyde_pink_beaver_e2220764:

    # player_name "R-right."
    player_name "对、对。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:376
translate chinese button_clyde_pink_beaver_5fbd2a8d:

    # player_name "Thanks, I guess..."
    player_name "那就谢谢了……大概吧。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:380
translate chinese button_clyde_pink_beaver_de746c0c:

    # clyde "Don't mention it, buddy!"
    clyde "别客气，老兄！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:382
translate chinese button_clyde_pink_beaver_dc399d59:

    # clyde "Now if you'll excuse me."
    clyde "那俺就先失陪了。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:383
translate chinese button_clyde_pink_beaver_7a46b7c0:

    # clyde "I wanna watch my dog give that ole beaver what fer!"
    clyde "俺想看俺家狗怎么收拾那只老海狸！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:387
translate chinese button_clyde_pink_beaver_a2af2dd6:

    # clyde "Hehehe."
    clyde "嘿嘿嘿。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:391
translate chinese button_clyde_pink_beaver_9a76f474:

    # player_name "( You know, this actually explains quite a lot about {b}Clyde{/b} and why he is the way he is... )"
    player_name "（说起来，这下总算明白{b}克莱德{/b}为什么会是这副样子了……）"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:393
translate chinese button_clyde_pink_beaver_f04f1a89:

    # player_name "( I guess I should keep an eye out for the other pieces of this statue. )"
    player_name "（我该留意这尊雕像的其他碎片。）"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:405
translate chinese button_clyde_mysterious_statue_1_3c2bd7de:

    # player_name "You know anything about this {b}Clyde{/b}?"
    player_name "{b}克莱德{/b}，你知道这东西的来历吗？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:408
translate chinese button_clyde_mysterious_statue_1_a3d144cb:

    # clyde "{i}*Gasp*{/i} Where in the world did you find that?!"
    clyde "{i}*倒吸一口气*{/i} 你从哪儿找到这东西的？！"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:411
translate chinese button_clyde_mysterious_statue_1_3b181887:

    # player_name "It was buried under my friend's house."
    player_name "它埋在我朋友家房子底下。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:415
translate chinese button_clyde_mysterious_statue_1_76ab6903:

    # player_name "The name {b}Delmont{/b} is etched in the bottom."
    player_name "底部刻着{b}德尔蒙特{/b}这个名字。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:418
translate chinese button_clyde_mysterious_statue_1_f71580cc:

    # clyde "Yeah."
    clyde "嗯。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:420
translate chinese button_clyde_mysterious_statue_1_2251ca75:

    # clyde "It's part of my grandpappy's good luck charm."
    clyde "这是俺爷爷那件幸运符的一部分。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:423
translate chinese button_clyde_mysterious_statue_1_54396e24:

    # player_name "Grandpappy?"
    player_name "爷爷？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:424
translate chinese button_clyde_mysterious_statue_1_3bd643e4:

    # player_name "You mean your grandfather?"
    player_name "你是说你祖父？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:427
translate chinese button_clyde_mysterious_statue_1_a35bc43a:

    # clyde "Uh huh, {b}Jebadiah Delmont{/b}."
    clyde "嗯哼，{b}杰巴迪亚·德尔蒙特{/b}。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:428
translate chinese button_clyde_mysterious_statue_1_71f268a9:

    # clyde "He was real famous in these parts many years ago for the milk his cows produced."
    clyde "很多年前，他因为自家奶牛产的奶在这一带特别有名。"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:431
translate chinese button_clyde_mysterious_statue_1_87edc735:

    # player_name "Cow milk?"
    player_name "牛奶？"

# lib/windows-i686/scripts/characters/clyde/button_dialogues.rpyc:433
translate chinese button_clyde_mysterious_statue_1_33c48f11:


    # tony "It was ugly business and I've been party to some real awfulness."
    tony "那是些很难看的勾当，我也参与过一些真正可怕的事。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:284
translate chinese tony_button_pizzeria_kill_809e6643:

    # tony f_sad_down "Things I gotta live with for the rest of my days."
    tony f_sad_down "那些事我得背一辈子。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:286
translate chinese tony_button_pizzeria_kill_7b2e3c21:

    # tony f_sad "Things you might think you wanna know about... But trust me, champ... You don't."
    tony f_sad "你也许以为自己想知道……但相信我，小子……你不想。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:287
translate chinese tony_button_pizzeria_kill_eb780b0f_1:

    # anon @ -m_talk "..."
    anon @ -m_talk "……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:288
translate chinese tony_button_pizzeria_kill_b5bf770b:

    # tony "Can you understand what I'm sayin'?"
    tony "你能明白我在说什么吗？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:289
translate chinese tony_button_pizzeria_kill_2b7f3d13:

    # anon "Y-yeah, I guess..."
    anon "是、是啊，大概吧……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:290
translate chinese tony_button_pizzeria_kill_d44fa72d:

    # tony f_suspicious @ a_point_under "Good, 'cause I really don't wanna go into that stuff with you."
    tony f_suspicious @ a_point_under "那就好，因为我真的不想跟你细说那些。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:295
translate chinese tony_button_pizzeria_maria_a8d66e4b:

    # anon f_normal "How did you and {b}Maria{/b} meet?"
    anon f_normal "你和{b}玛丽亚{/b}是怎么认识的？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:296
translate chinese tony_button_pizzeria_maria_e58d8a47:

    # tony f_normal a_heart @ f_laugh a_point "Ahh, now there's a story worth tellin'!"
    tony f_normal a_heart @ f_laugh a_point "啊，这才是个值得讲的故事！"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:297
translate chinese tony_button_pizzeria_maria_2eef1d67:

    # tony "{b}Maria{/b} and I met when we was kids back in Brooklyn."
    tony "我和{b}玛丽亚{/b}是在布鲁克林小时候认识的。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:298
translate chinese tony_button_pizzeria_maria_25ca3a4c:

    # anon "You guys are from Brooklyn?"
    anon "你们是布鲁克林人？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:299
translate chinese tony_button_pizzeria_maria_b0e7dfc2:

    # tony a_idle @ a_finger_up "Yeah, that's right."
    tony a_idle @ a_finger_up "对，没错。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:300
translate chinese tony_button_pizzeria_maria_94cbe410:

    # tony "You see, she came from a well-to-do family."
    tony "你知道，她出身富裕人家。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:301
translate chinese tony_button_pizzeria_maria_782d09fe:

    # tony "Her father owned this fancy restaurant over on the east side and her ma used to volunteer at the orphanage where I grew up."
    tony "她爸在东区开了家高档餐厅，她妈以前在我长大的那家孤儿院做义工。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:302
translate chinese tony_button_pizzeria_maria_f4c0268e:

    # anon "Oh?"
    anon "哦？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:303
translate chinese tony_button_pizzeria_maria_7e1f125c:

    # tony "You know, servin' food to all us street rats and patchin' up our clothes."
    tony "给我们这些街头野孩子打饭、缝补衣服。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:304
translate chinese tony_button_pizzeria_maria_fdf8969d:

    # tony "That kinda thing."
    tony "就是这种活儿。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:305
translate chinese tony_button_pizzeria_maria_b6418651:

    # tony @ f_smirk_wink a_frustrated "She was a real generous woman, {b}Maria{/b}'s ma and the apple didn't fall far from the tree."
    tony @ f_smirk_wink a_frustrated "她是个很慷慨的女人，{b}玛丽亚{/b}的妈妈，而且有其母必有其女。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:307
translate chinese tony_button_pizzeria_maria_37e90f7a:

    # tony "So you see, one day she brings {b}Maria{/b} down to the orphanage with her..."
    tony "所以你看，有一天她带着{b}玛丽亚{/b}来孤儿院……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:308
translate chinese tony_button_pizzeria_maria_abb5ec9c:

    # tony "And they're both cookin' up a storm, makin' the whole place smell wonderful."
    tony "母女俩一起大展厨艺，把整个地方搞得香喷喷的。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:310
translate chinese tony_button_pizzeria_maria_e5710f92:

    # tony "I mean, she couldn't have been more than thirteen at the time, but she was a fuckin' savant in the kitchen, even then!"
    tony "我是说，她那时候最多十三岁，可她在厨房里就已经他妈是个天才了！"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:311
translate chinese tony_button_pizzeria_maria_aa8564ae:

    # tony f_smirk_closed a_heart "Phew, lemme tell ya... I was smitten the second I saw her."
    tony f_smirk_closed a_heart "呼，跟你说……我一看见她就神魂颠倒了。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:312
translate chinese tony_button_pizzeria_maria_d6bbf9d8:

    # tony f_normal a_idle @ f_smirk_wink "Then I tasted her cannolis."
    tony f_normal a_idle @ f_smirk_wink "后来我尝了她做的卡诺利甜卷。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:313
translate chinese tony_button_pizzeria_maria_46e3608c:

    # tony "I told her right then and there I was gonna marry her someday."
    tony "我当场就跟她说，我总有一天要娶她。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:314
translate chinese tony_button_pizzeria_maria_839a8497:

    # anon f_surprised "Really?!"
    anon f_surprised "真的？！"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:315
translate chinese tony_button_pizzeria_maria_86db59af:

    # tony @ -m_talk "Mhmm."
    tony @ -m_talk "嗯嗯。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:316
translate chinese tony_button_pizzeria_maria_30af28cb:

    # anon f_normal "What did she say?"
    anon f_normal "她怎么说？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:317
translate chinese tony_button_pizzeria_maria_0d0016c4:

    # tony "Ahh, she turned red as a beet and then told me to shut my piehole."
    tony "啊，她脸涨得通红，然后叫我闭嘴。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:318
translate chinese tony_button_pizzeria_maria_35a200f3:

    # anon "You mean, she didn't like you back?"
    anon "你是说，她当时不喜欢你？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:319
translate chinese tony_button_pizzeria_maria_e4b166a4:

    # tony "Nah, she just... Well-"
    tony "不，她只是……那个——"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:321
translate chinese tony_button_pizzeria_maria_063a24c7:

    # tony "The good ones make you work for it, champ."
    tony "好姑娘都会让你费点功夫，小子。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:322
translate chinese tony_button_pizzeria_maria_2dc9f0be:

    # tony @ f_smirk_wink "Remember that."
    tony @ f_smirk_wink "记住这个。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:324
translate chinese tony_button_pizzeria_maria_c6130a64:

    # anon "So you two have been together for a long time then?"
    anon "那你们俩在一起很久了？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:325
translate chinese tony_button_pizzeria_maria_96e81ab0:

    # tony "Almost thirty years."
    tony "快三十年了。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:326
translate chinese tony_button_pizzeria_maria_ccd5313c:

    # anon "That's wonderful, {b}Tony{/b}."
    anon "那真好，{b}托尼{/b}。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:327
translate chinese tony_button_pizzeria_maria_2e94b53a:

    # tony "Ain't it?"
    tony "可不是嘛？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:328
translate chinese tony_button_pizzeria_maria_3fe63c6f:

    # tony @ a_point_back "{i}*Sigh*{/i} Man, it took a long time to convince her father I was worth a damn..."
    tony @ a_point_back "{i}*唉*{/i} 天哪，我花了好长时间才让她爸相信我还是个有用的人……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:329
translate chinese tony_button_pizzeria_maria_443954c5:

    # anon "He didn't approve?"
    anon "他不赞成？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:330
translate chinese tony_button_pizzeria_maria_e47e0fb2:

    # tony f_suspicious @ a_wave "Ahh, of course not!"
    tony f_suspicious @ a_wave "啊，当然不赞成！"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:331
translate chinese tony_button_pizzeria_maria_923b643a:

    # tony "I was just some nobody without a cent in my pocket."
    tony "我不过是个口袋空空的无名小卒。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:332
translate chinese tony_button_pizzeria_maria_03fe5c15:

    # tony "He knew I wasn't good enough for his daughter."
    tony "他清楚我配不上他女儿。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:333
translate chinese tony_button_pizzeria_maria_3a748025:

    # anon "But you proved him wrong?"
    anon "但你证明他错了？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:334
translate chinese tony_button_pizzeria_maria_76da7dde:

    # tony f_normal @ f_smirk_wink "Well, you could say that..."
    tony f_normal @ f_smirk_wink "嗯，可以这么说……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:335
translate chinese tony_button_pizzeria_maria_fb15f284:

    # tony "I got myself a job, makin' decent money, and saved every cent I had for three years."
    tony "我找了份工作，收入还不错，三年里把每一分钱都攒了下来。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:336
translate chinese tony_button_pizzeria_maria_58c922c1:

    # tony "Then I bought a nice little place on the east side and asked her father for his approval."
    tony "然后我在东区买了套不错的小房子，去求她父亲同意。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:337
translate chinese tony_button_pizzeria_maria_e81f789a:

    # anon "And?"
    anon "然后呢？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:338
translate chinese tony_button_pizzeria_maria_2b2d85ae:

    # tony @ f_laugh a_belly "Heh, the tough old bastard broke two of my ribs and fractured my eye socket."
    tony @ f_laugh a_belly "嘿，那老混蛋打断了我两根肋骨，还把我眼眶打裂了。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:339
translate chinese tony_button_pizzeria_maria_75f365fd:

    # anon f_surprised "!!!"
    anon f_surprised "！！！"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:340
translate chinese tony_button_pizzeria_maria_503fd3fd:

    # anon "For real?!"
    anon "真的？！"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:341
translate chinese tony_button_pizzeria_maria_d7f7dda4:

    # tony f_sad "I never was good enough for him..."
    tony f_sad "我从来就没让他觉得我够格……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:343
translate chinese tony_button_pizzeria_maria_2fd4cd3b:

    # tony f_normal @ a_finger_up "... But I was good enough for her, and that's what matters."
    tony f_normal @ a_finger_up "……但对她来说我够好了，这才是最重要的。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:344
translate chinese tony_button_pizzeria_maria_9b2f6bb9:

    # tony @ f_smirk_wink "Remember that, champ."
    tony @ f_smirk_wink "记住这个，小子。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:345
translate chinese tony_button_pizzeria_maria_925a7770:

    # anon f_normal "Y-yeah, okay {b}Tony{/b}."
    anon f_normal "好、好的，{b}托尼{/b}。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:347
translate chinese tony_button_pizzeria_maria_813b1035:

    # tony @ a_frustrated "Sheesh, listen to me."
    tony @ a_frustrated "天哪，听听我这张嘴。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:348
translate chinese tony_button_pizzeria_maria_4f3f392b:

    # tony "Gabbin' on like an old lady in a hair salon."
    tony "像美容院里的老太太一样唠叨个没完。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:349
translate chinese tony_button_pizzeria_maria_79483f21:

    # tony "What do you say we get those pizzas delivered, eh?"
    tony "要不咱们去把那些披萨送了吧，嗯？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:354
translate chinese tony_button_pizzeria_quit_216ee4f4:

    # anon f_worried "Why did you quit?"
    anon f_worried "你为什么不干了？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:355
translate chinese tony_button_pizzeria_quit_a60cfc5a:

    # tony f_sad "Eh, twenty years of extortin' people starts to wear on a person, you know?"
    tony f_sad "呃，敲诈别人敲了二十年，人也会累的，你知道吗？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:356
translate chinese tony_button_pizzeria_quit_1eb5a11a:

    # tony "I couldn't do it no more."
    tony "我干不下去了。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:357
translate chinese tony_button_pizzeria_quit_d0575873:

    # tony "Then Luigi died and I realized that everyone I came up with was either in the ground or in prison."
    tony "后来路易吉死了，我才发现跟我一起混上来的人，不是进了土里，就是进了监狱。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:359
translate chinese tony_button_pizzeria_quit_5054da77:

    # tony "We packed up, grabbed {b}Tina{/b} and her girl, and got the hell outta there."
    tony "我们收拾东西，带上{b}蒂娜{/b}和她女儿，赶紧离开了那鬼地方。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:360
translate chinese tony_button_pizzeria_quit_4118a00b:

    # tony "Decided to try the quiet life for a while."
    tony "决定先过过安稳日子。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:361
translate chinese tony_button_pizzeria_quit_1cd2ae2e:

    # anon f_normal "So you opened up a pizzeria?"
    anon f_normal "所以你就开了家披萨店？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:362
translate chinese tony_button_pizzeria_quit_286b74c0:

    # tony f_normal "Heh, why not, eh?"
    tony f_normal "嘿，为什么不呢？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:363
translate chinese tony_button_pizzeria_quit_97208cd8:

    # tony "{b}Maria{/b} loves cookin' and there ain't many restaurants in this little town."
    tony "{b}玛丽亚{/b}喜欢做饭，这小镇上也没几家餐馆。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:364
translate chinese tony_button_pizzeria_quit_47a10dcc:

    # anon "That's true."
    anon "这倒是。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:369
translate chinese tony_button_pizzeria_russians_a7cc21b1:

    # anon f_worried "About those Russians..."
    anon f_worried "关于那些俄罗斯人……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:370
translate chinese tony_button_pizzeria_russians_097b0c32:

    # tony f_suspicious "What about 'em?"
    tony f_suspicious "他们怎么了？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:371
translate chinese tony_button_pizzeria_russians_5bd5802f:

    # anon "I'm curious how you know them?"
    anon "我好奇你是怎么认识他们的？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:372
translate chinese tony_button_pizzeria_russians_faa49cae:

    # tony "Ehh, that's a long story, champ..."
    tony "呃，说来话长，小子……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:373
translate chinese tony_button_pizzeria_russians_03ab41b6:

    # tony "Let's just say I've had dealings with them in the past, okay?"
    tony "就说我以前跟他们打过交道，行吗？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:374
translate chinese tony_button_pizzeria_russians_c6e322d8:

    # anon "Alright."
    anon "好吧。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:375
translate chinese tony_button_pizzeria_russians_9da61feb:

    # anon "You mentioned someone named {b}Raz{/b}..."
    anon "你提过一个叫{b}拉兹{/b}的人……"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:376
translate chinese tony_button_pizzeria_russians_bbcf42ed:

    # anon "Who is he?"
    anon "他是谁？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:377
translate chinese tony_button_pizzeria_russians_9a0d5417:

    # tony "{b}Raz{/b} is their boss."
    tony "{b}拉兹{/b}是他们的老大。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:378
translate chinese tony_button_pizzeria_russians_ce531838:

    # anon "How does that work?"
    anon "那是怎么运作的？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:379
translate chinese tony_button_pizzeria_russians_098344ef:

    # tony "What do you mean?"
    tony "你什么意思？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:380
translate chinese tony_button_pizzeria_russians_ad964835:

    # anon "I mean, since when do criminals have bosses?"
    anon "我是说，犯罪分子什么时候也有老板了？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:381
translate chinese tony_button_pizzeria_russians_3892970a:

    # tony "They're Bratva, kid."
    tony "他们是黑帮，孩子。"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:382
translate chinese tony_button_pizzeria_russians_07e55c79:

    # anon @ f_skeptical "Bratva?"
    anon @ f_skeptical "黑帮？"

# lib/windows-i686/scripts/characters/tony/dialogue/pizzeria.rpyc:383
translate chinese tony_button_pizzeria_russians_782a2aad:

